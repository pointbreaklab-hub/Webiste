---
import Cursor from '../components/Cursor.astro';
import { localeFromPath, englishPath, germanPath } from '../i18n';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const locale = localeFromPath(Astro.url.pathname);
const {
  title = locale === 'de'
    ? 'PointBreakLab · Apps ohne Server'
    : 'PointBreakLab · Privacy-First Applications',
  description = locale === 'de'
    ? 'PointBreakLab ist eine Person, die Apps baut, deren Daten auf deinen eigenen Geräten bleiben. Whispr, Heart, Knot und Knot AI, alle kostenlos.'
    : 'PointBreakLab is one person building apps that keep your data on the devices you own. Whispr, Heart, Knot and Knot AI, all free.',
  // PNG, not SVG: WhatsApp, iMessage, LinkedIn and Facebook don't render SVG
  // preview images (WhatsApp then fell back to a photo on the page).
  ogImage = '/og-image.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();

// hreflang alternates, only when the page really has a German twin. Each
// page lists both versions plus x-default (English), so the pair is
// reciprocal, which Google requires before it trusts either side.
const enUrl = new URL(englishPath(Astro.url.pathname), Astro.site).toString();
const dePath = germanPath(Astro.url.pathname);
const deUrl = dePath ? new URL(dePath, Astro.site).toString() : null;
const ogImageUrl = new URL(ogImage, Astro.site).toString();

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'PointBreakLab',
  url: 'https://pointbreaklab.com',
  logo: 'https://pointbreaklab.com/favicon.svg',
  description: 'One person building applications that keep your data on the devices you own.',
  founder: {
    '@type': 'Person',
    name: 'Roshan Kumar Gupta',
    jobTitle: 'Student',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Würzburg',
    addressCountry: 'DE',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'mail.roshankumargupta@gmail.com',
    contactType: 'general',
  },
};

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Whispr',
  applicationCategory: 'CommunicationApplication',
  operatingSystem: 'Android',
  description: 'Encrypted messenger with no account and no server. Signal Protocol over your LAN or over Tor, and a Bluetooth mesh that relays phone to phone when there is no signal.',
  downloadUrl: 'https://github.com/pointbreaklab-hub/Whispr/releases/latest/download/whispr-android.apk',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'PointBreakLab' },
};
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {deUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {deUrl && <link rel="alternate" hreflang="de" href={deUrl} />}
    {deUrl && <link rel="alternate" hreflang="x-default" href={enUrl} />}

    <!-- OG / Twitter -->
    <meta property="og:title"        content={title} />
    <meta property="og:description"  content={description} />
    <meta property="og:image"        content={ogImageUrl} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type"   content="image/png" />
    <meta property="og:image:alt"    content={locale === 'de' ? 'PointBreakLab: Apps, die deine Daten auf deinen Geräten lassen' : 'PointBreakLab: privacy-first applications'} />
    <meta property="og:url"          content={canonical} />
    <meta property="og:type"         content="website" />
    <meta property="og:site_name"    content="PointBreakLab" />
    <meta property="og:locale"       content={locale === 'de' ? 'de_DE' : 'en_US'} />
    {deUrl && <meta property="og:locale:alternate" content={locale === 'de' ? 'en_US' : 'de_DE'} />}
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Structured data for Google rich snippets -->
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />
  </head>
  <body class="bg-bg text-primary font-sans antialiased overflow-x-hidden">
    <Cursor />
    <slot />
    <script>
      // Intersection Observer for scroll reveal
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.section-reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
