---
import Base           from '../layouts/Base.astro';
import Nav            from '../components/Nav.astro';
import Hero           from '../components/Hero.astro';
import AppCard        from '../components/AppCard.astro';
import Footer         from '../components/Footer.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import '../styles/global.css';
---

<Base>
  <Nav />
  <Hero />

  <!-- ── 01 THE LAB, apps lineup ──────────────────────────────────────── -->
  <section id="apps" class="relative py-32 px-6 max-w-7xl mx-auto">
    <div aria-hidden="true" class="absolute top-0 left-1/2 -translate-x-1/2 w-[60%] h-64 bg-accent/[0.07] blur-3xl pointer-events-none"></div>
    <div class="section-reveal text-center mb-16">
      <SectionEyebrow num="01" label="THE LAB" />
      <h2 class="text-3xl md:text-5xl font-black text-primary mb-4">The apps</h2>
      <p class="text-secondary max-w-xl mx-auto leading-relaxed">
        Four of these you can install today. Elixir is still being built.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <AppCard
        name="Whispr"
        tagline="PRIVATE BY DEFAULT"
        description="Whispr runs the Signal Protocol over your LAN, or over Tor when you are not on the same network. With no network at all it goes by Bluetooth, hopping phone to phone until it reaches the right person, which took about an hour over a distance under 5 km. Your identity is a key the app generates on the phone."
        icon="🔒"
        href="/whispr/"
        active={true}
      />
      <AppCard
        name="Heart"
        tagline="LOCAL-FIRST WELLNESS"
        description="A wellness app for Bluetooth heart-rate bands. HR, HRV, sleep stages, recovery and strain, on the phone. No band, nothing to read."
        icon="❤️"
        href="/heart/"
        active={true}
      />
      <AppCard
        name="Knot"
        tagline="PEER-TO-PEER VERSION CONTROL"
        description="Save a file. Knot waits until you stop typing, then makes a real commit. That commit goes to every paired machine over Tor."
        icon="🪢"
        href="/knot/"
        active={true}
        status="V1"
      />
      <AppCard
        name="Knot AI"
        tagline="TWO ON-DEVICE MODELS"
        description="Knot Scribe writes commit messages. Knot Delta explains what changed, and it pins the exact line 52 to 74% of the time, lowest on Rust. The weights are on Hugging Face and Ollama."
        icon="✍️"
        href="/knot-ai/"
        active={true}
        status="OPEN MODEL"
      />
      <AppCard
        name="Elixir"
        tagline="OFFLINE VAULT · COMING LATER"
        description="An encrypted vault that stays on one device: passwords, recovery codes, anything you'd lose sleep over leaking."
        icon="🧪"
      />
    </div>
  </section>

  <!-- ── 02 PROOF ──────────────────────────────────────────────────────────
       Receipts for the no-server claim in the hero badge. Privacy products carry a
       higher proof burden than most product claims because users can't
       verify them by using the product, only by inspecting the
       architecture. The full architecture lives at /whispr/#architecture;
       this is a compact excerpt so the homepage shows evidence, not just
       claims. (Added 2026-05-07 after homepage-split review.) Don't strip
       this back, competitors (Signal, Session, Briar, SimpleX) all lead
       with cryptographic architecture above the fold.                    -->
  <section id="proof" class="relative py-32 px-6 bg-surface border-y border-border overflow-hidden">
    <div aria-hidden="true" class="absolute top-0 left-1/2 -translate-x-1/2 w-[70%] h-72 bg-accent/[0.08] blur-3xl pointer-events-none"></div>
    <div class="relative max-w-3xl mx-auto">
      <div class="section-reveal text-center mb-12">
        <SectionEyebrow num="02" label="PROOF" />
        <h2 class="text-3xl md:text-5xl font-light text-primary mb-4 tracking-tight">What holds for every app here</h2>
        <p class="text-secondary max-w-xl mx-auto leading-relaxed">
          Whispr, Heart and Knot were built without a server behind them, and Elixir will be the same. Knot was the hard one, because peer-to-peer version control is where a central server would have been the easy answer.
        </p>
      </div>

      <div class="section-reveal font-mono text-sm rounded-2xl bg-bg border border-border overflow-hidden">
        <div class="flex items-center gap-2 px-5 py-3 border-b border-border bg-surface">
          <div class="w-3 h-3 rounded-full bg-error/70"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
          <div class="w-3 h-3 rounded-full bg-accent/70"></div>
          <span class="ml-2 text-hint text-xs">stack.txt</span>
        </div>
        {/* Studio-level guarantees only, what's true of EVERY PBL app
            (Whispr, Heart, Knot, Elixir). Whispr-specific primitives like
            X3DH, Double Ratchet, and the ECIES wire envelope live on
            /whispr/#architecture because they're messaging-only and would
            misrepresent the other apps. The link below sends interested
            visitors there. (Generalised 2026-05-08 after a review pointed
            out the homepage panel was Whispr-specific in disguise.) */}
        <div class="p-6 space-y-2.5 text-xs md:text-sm leading-relaxed overflow-x-auto">
          {[
            ['Storage',     'SQLCipher · AES-256 · full-file encryption · on device'],
            ['Server',      'None · peer-to-peer or local-only by design'],
            ['Accounts',    'None · no email, no phone, no registration'],
            ['Telemetry',   'None · no analytics, no crash reports, no usage pings'],
            ['Trust model', 'Published algorithms · you cannot rebuild the binaries yourself'],
          ].map(([key, val]) => (
            <div class="flex gap-4 items-baseline">
              <span class="text-hint shrink-0 w-32">{key}</span>
              <span class="text-accent">→</span>
              <span class="text-primary/80">{val}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="section-reveal text-center mt-10">
        <a
          href="/whispr/#architecture"
          class="inline-flex items-center gap-2 text-accent text-sm font-semibold hover:gap-3 transition-all"
        >
          Per-app cryptography (Whispr's Signal Protocol stack, etc.) <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── 03 THE STUDIO ─────────────────────────────────────────────────── -->
  <section id="about" class="relative py-32 px-6 max-w-5xl mx-auto">
    <div aria-hidden="true" class="absolute top-0 left-0 w-[40%] h-64 bg-accent/[0.05] blur-3xl pointer-events-none"></div>
    <div class="section-reveal grid grid-cols-1 md:grid-cols-2 gap-16 items-center">

      <div>
        <div class="mb-3"><SectionEyebrow num="03" label="THE STUDIO" align="left" /></div>
        <h2 class="text-3xl md:text-4xl font-black text-primary mb-6">About PointBreakLab</h2>
        {/* The only first-person block on the site. His photo, his name and the
             university crest sit in the column beside it, and every fact here is
             something only he can say. The rest of the site stays in the neutral
             product voice. Owner confirmed the account this is written from. */}
        <p class="text-secondary leading-relaxed mb-5">
          I started with Whispr. I wanted a chat app where nobody has to be scared someone is watching. Every one I found runs through a server, so Whispr has no physical server and your data stays with you. The website exists because Whispr needed a home.
        </p>
        <p class="text-secondary leading-relaxed mb-5">
          The name was trouble. Nothing fit for a long time, then I heard Point Break in an Avengers film and liked it enough to keep it. Lab I mean literally. None of these apps happened by fluke and each one has research behind it. I believe one day people will look into it and recognise PointBreakLab.
        </p>
        <p class="text-secondary leading-relaxed mb-8">
          Heart I built for myself, off a cheap Coospo HW9 chest strap, to read my own body data. Then Knot, version control where your code belongs to your machine. There is honestly too much built here now and I keep shipping updates. They are free.
        </p>
        <div id="contact" class="flex gap-4">
          <a href="mailto:mail.roshankumargupta@gmail.com"
             class="px-5 py-2.5 rounded-xl bg-surface border border-border text-sm text-secondary hover:border-accent hover:text-primary transition-all">
            Contact
          </a>
        </div>
      </div>

      <div class="flex flex-col items-center gap-4">
        <img
          src="/roshan.jpg"
          alt="Roshan Kumar Gupta"
          width="176"
          height="176"
          loading="lazy"
          class="w-44 h-44 rounded-full object-cover border-2 border-accent/30 glow-border animate-glow-pulse"
        />
        <div class="text-center">
          <p class="text-primary font-bold">Roshan Kumar Gupta</p>
          <p class="text-secondary text-sm">Student · builds and ships everything here</p>
          <!-- JMU affiliation: official UNI WÜ mark + historic seal + name. -->
          <a
            href="https://www.uni-wuerzburg.de/en/"
            target="_blank"
            rel="noopener noreferrer"
            title="Julius-Maximilians-Universität Würzburg"
            class="group flex flex-col items-center gap-2 mt-2.5 hover:opacity-90 transition-opacity"
          >
            <div class="flex items-center justify-center gap-2">
              <img src="/jmu-uniwue.png" alt="Julius-Maximilians-Universität Würzburg" width="32" height="32" loading="lazy" class="h-8 w-8 rounded-[6px]" />
              <span class="text-secondary text-sm group-hover:text-primary transition-colors">Julius-Maximilians</span>
            </div>
          </a>
          <p class="text-hint text-xs font-mono mt-1.5">📍 Würzburg, Germany</p>
          <a
            href="https://www.openstreetmap.org/?mlat=49.7913&mlon=9.9534#map=12/49.7913/9.9534"
            target="_blank"
            rel="noopener noreferrer"
            title="Würzburg, Germany, open in OpenStreetMap"
            class="group block mx-auto mt-3 w-44 rounded-xl overflow-hidden border border-border hover:border-accent/50 transition-colors"
          >
            <img
              src="/wuerzburg-map.png"
              alt="Map showing Würzburg, Germany"
              width="176"
              height="176"
              loading="lazy"
              class="w-44 h-44 object-cover group-hover:scale-[1.03] transition-transform duration-300"
            />
          </a>
          <p class="text-[10px] text-hint mt-1">
            © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer" class="hover:text-accent">OpenStreetMap</a> contributors
          </p>
        </div>
        <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 border border-accent/20">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          <span class="text-accent text-xs font-mono">Building in public</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 04 UPDATES, "From the lab" news feed ───────────────────────────────
       Page-rendered list (no widget): always non-empty, no login, no tracker.
       To post an update, prepend an entry to the `updates` array below and
       redeploy, same pattern as the per-product changelogs. The h2 names the
       month the entries are from, so change it when you prepend. -->
  <section id="updates" class="relative py-32 px-6 max-w-3xl mx-auto">
    <div aria-hidden="true" class="absolute top-0 left-1/2 -translate-x-1/2 w-[60%] h-64 bg-accent/[0.07] blur-3xl pointer-events-none"></div>
    <div class="section-reveal text-center mb-12">
      <SectionEyebrow num="04" label="UPDATES" />
      <h2 class="text-3xl md:text-5xl font-black text-primary mb-4">Both of June's updates were Knot</h2>
      <p class="text-secondary max-w-xl mx-auto leading-relaxed">
        New entries land here when something ships, which is not often.
      </p>
    </div>

    <div class="space-y-4">
      {[
        {
          date: 'Jun 2026',
          tag: 'KNOT',
          title: 'Knot is here',
          body: 'Syncs a folder between machines over Tor, and the two ends talk straight to each other. Mac and Linux, free on the Knot page.',
        },
        {
          date: 'Jun 2026',
          tag: 'KNOT',
          title: 'Follow Knot from your phone',
          body: 'A phone app that mirrors every synced repo read-only over the LAN, so you can keep an eye on the work from anywhere in the house.',
        },
      ].map(({ date, tag, title, body }) => (
        <div class="section-reveal flex gap-5 p-5 rounded-2xl bg-surface border border-border hover:border-accent/30 transition-colors">
          <div class="shrink-0 w-20 pt-1">
            <p class="text-accent text-xs font-mono tracking-widest">{tag}</p>
            <p class="text-hint text-xs font-mono mt-1">{date}</p>
          </div>
          <div>
            <h3 class="text-base font-bold text-primary mb-1.5 leading-snug">{title}</h3>
            <p class="text-secondary text-sm leading-relaxed">{body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <Footer />
</Base>
