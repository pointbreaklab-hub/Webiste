---
import Base                 from '../../layouts/Base.astro';
import Nav                  from '../../components/Nav.astro';
import FeatureBlock         from '../../components/FeatureBlock.astro';
import DownloadButton       from '../../components/DownloadButton.astro';
import Footer               from '../../components/Footer.astro';
import SectionEyebrow       from '../../components/SectionEyebrow.astro';
import ArchitectureDiagram  from '../../components/ArchitectureDiagram.astro';
import '../../styles/global.css';

// LEAN REWRITE 2026-07-28 (owner: "too much content is a dead end"). Same
// treatment as the Knot page: get to the download fast. Cut the 3-step
// "how it works" block (the architecture diagram covers it) and 6 -> 4
// feature cards; pulled the download up from section 4 to section 2. The
// crypto proof (diagram + security-architecture.txt) and roadmap are kept
// below the fold for the readers who want depth. Do NOT restore the cut bits.
//
// OPEN QUESTIONS FOR THE OWNER (kept here, not in HTML comments: Astro does
// not strip <!-- --> and anything in one is readable in view-source).
//  1. The real reason there is no iOS build. Most likely the Apple Developer
//     Program fee; section 02 currently states the fact without the reason.
//  2. Section 03's lead reads better in the first person. The we-free version
//     ships until the owner decides the site-wide person question.
---

<Base
  title="Whispr · Private messenger by PointBreakLab"
  description="A messenger with no account and no server. Signal Protocol end-to-end encryption over Wi-Fi or Tor, and over a Bluetooth mesh that relays phone to phone when there is no signal at all, slowly."
>
  <Nav />

  <!-- ── HERO ─────────────────────────────────────────────────────────────── -->
  <section class="relative pt-32 pb-20 px-6 overflow-hidden">
    <div aria-hidden="true" class="absolute top-0 left-1/2 -translate-x-1/2 w-[80%] h-[28rem] bg-accent/[0.08] blur-3xl pointer-events-none"></div>
    <div aria-hidden="true" class="absolute top-1/3 right-0 w-72 h-72 bg-blue-500/[0.04] blur-3xl pointer-events-none"></div>

    <div class="relative max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-accent/30 bg-accent/5 text-accent text-xs font-mono tracking-wider mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        WHISPR · v1.1.16
      </div>

      <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-[1.05] mb-6">
        <span class="text-primary">A messenger that works</span><br/>
        <span class="text-gradient">with the internet off.</span>
      </h1>

      <p class="text-lg text-secondary font-light max-w-xl mx-auto leading-relaxed mb-3">
        With no signal at all a message hops from phone to phone over Bluetooth until it reaches the person it is for. That took about an hour in testing.
      </p>
      <p class="text-sm text-secondary font-mono leading-relaxed mb-10">
        End-to-end encrypted via the <span class="text-primary">Signal Protocol</span> · X3DH + Double Ratchet ·
        <a href="#architecture" class="text-accent whitespace-nowrap hover:underline">see the crypto →</a>
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#download"
          class="px-8 py-3.5 rounded-xl bg-accent text-bg font-bold text-sm hover:bg-white transition-all hover:scale-105 hover:shadow-[0_0_32px_rgba(0,212,170,0.4)]"
        >
          Download for Android
        </a>
        <a
          href="#architecture"
          class="px-8 py-3.5 rounded-xl border border-border text-secondary text-sm hover:border-accent hover:text-primary transition-all"
        >
          See the crypto
        </a>
      </div>
    </div>
  </section>

  <!-- ── 01 WHAT IT DOES (4 features + the three transports) ──────────────── -->
  <section id="features" class="relative py-24 px-6 max-w-6xl mx-auto">
    <div aria-hidden="true" class="absolute top-0 left-1/4 w-[40%] h-72 bg-accent/[0.06] blur-3xl pointer-events-none"></div>

    <div class="section-reveal text-center mb-14">
      <SectionEyebrow num="01" label="TRANSPORTS" />
      <h2 class="text-3xl md:text-5xl font-black text-primary mb-4">Messages that travel without a server</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-20">
      <FeatureBlock
        icon="🌐"
        title="The other person still has it"
        description="Messages go from one phone to the other with no company server in between. Encryption does not take the message back out of their phone."
      />
      <FeatureBlock
        icon="🔐"
        title="Signal Protocol"
        description="X3DH and a Double Ratchet, against Signal's published spec."
      />
      <FeatureBlock
        icon="🆔"
        title="No account"
        description="Your identity is an Ed25519 key pair made on the phone, and if you lose the phone the key goes with it, the way an SSH key does."
      />
      <FeatureBlock
        icon="📧"
        title="Encrypted email"
        description="ECIES-encrypted mail between Whispr users, with threads and reply-all."
      />
    </div>

    <!-- The three transports (the real differentiator: works with no internet). -->
    <div class="section-reveal">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          // CONFIRM: measured LAN delivery time in ms on the author's own Wi-Fi.
          { icon: '🏠', label: 'LAN', title: 'Local network', body: 'On the same Wi-Fi the phones talk straight to each other.' },
          // Owner-measured, n=1: Germany to India in under a minute. Still unconfirmed whether
          // that run included the initial circuit build or reused a warm circuit.
          { icon: '🧅', label: 'TOR', title: 'Tor network',   body: 'A Tor hidden service reaches someone who is not on your network. One message from Germany to India landed in under a minute. The first message of a session waits while the circuit builds.' },
          // Owner-measured, n=2: under 5 km, ~1 h and 1 h 25 min. The route is whatever
          // devices are in range, so the time is not controllable. Still unknown and worth
          // measuring: the HOP COUNT on those runs, and whether anything beyond 5 km works.
          { icon: '📶', label: 'BLE', title: 'BLE mesh',      body: 'Each hop is short, but a phone that receives a message passes it on, and nobody in the chain can read it. Tested twice under 5 km it arrived in about an hour, then in an hour and twenty-five minutes. The route is whatever devices happen to be in between, so that time is not something anyone controls.' },
        ].map(({ icon, label, title, body }) => (
          <div class="p-6 rounded-2xl bg-surface border border-border hover:border-accent/30 transition-colors text-center group">
            <div class="text-4xl mb-4">{icon}</div>
            <div class="inline-block px-2 py-0.5 rounded bg-accent/10 text-accent text-xs font-mono mb-3">{label}</div>
            <h4 class="text-base font-bold text-primary mb-2">{title}</h4>
            <p class="text-secondary text-sm leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 02 GET IT (moved up from section 4) ──────────────────────────────── -->
  <section id="download" class="relative py-28 px-6 bg-surface border-y border-border overflow-hidden">
    <div aria-hidden="true" class="absolute top-0 left-1/2 -translate-x-1/2 w-[70%] h-80 bg-accent/[0.10] blur-3xl pointer-events-none"></div>
    <div class="relative max-w-2xl mx-auto">
      <div class="section-reveal text-center">
        <SectionEyebrow num="02" label="GET THE APK" />
        <h2 class="text-3xl md:text-5xl font-black text-primary mb-4">Get the APK</h2>
        <p class="text-secondary mb-10">Android only, and you will be sideloading the APK, so Android warns you before it installs; if you want to check the signature it should read CN=Whispr, not CN=Android Debug. There is no iOS build.</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-3">
          <DownloadButton
            platform="android"
            href="https://github.com/pointbreaklab-hub/Whispr/releases/latest/download/whispr-android.apk"
            label="Android APK"
          />
          <DownloadButton platform="ios" href="#" />
        </div>

        <!-- Download counter, fetched client-side from GitHub API, hidden until 1000+ -->
        <div id="download-count" class="hidden text-xs font-mono text-hint mb-7"></div>

        <div class="text-left p-5 rounded-2xl bg-bg border border-border font-mono text-xs space-y-1.5">
          <div class="flex gap-3"><span class="text-hint w-32">Version</span><span class="text-primary">1.1.16</span></div>
          <div class="flex gap-3"><span class="text-hint w-32">Released</span><span class="text-primary">2026-05-17</span></div>
          <div class="flex gap-3"><span class="text-hint w-32">Cost</span><span class="text-primary/80">Free.</span></div>
          <div class="flex gap-3 mt-3 pt-3 border-t border-border"><span class="text-hint w-32">SHA-256 (APK)</span><span class="text-primary/60 break-all">3790f59b17c9d5886f77a79d985143cde8b62793aa73d781a177a75968eadf24</span></div>
        </div>

        <p class="text-hint text-xs mt-4">
          Full release history: <a href="/whispr/changelog/" class="text-accent hover:underline">changelog</a>
        </p>
      </div>

      <!-- Censored-region note. The full guide lives INSIDE the app so users
           don't leave the install flow to find it. -->
      <div class="section-reveal mt-12 p-6 rounded-2xl bg-bg border border-border">
        <div class="flex items-start gap-4">
          <div class="shrink-0 w-10 h-10 rounded-xl bg-accent/10 border border-accent/30 flex items-center justify-center text-xl">🌐</div>
          <div>
            <p class="text-accent text-xs font-mono tracking-widest mb-2">USING WHISPR WHERE TOR IS BLOCKED</p>
            <h3 class="text-lg font-bold text-primary mb-2">India · Iran · China · restrictive Wi-Fi</h3>
            <p class="text-secondary text-sm leading-relaxed mb-3">
              Some networks block Tor. If your messages don't deliver, install Whispr and open <span class="text-primary">Settings → Network → Bridges</span>. Tap the <span class="font-mono text-accent">(i)</span> icon there for a full step-by-step guide to setting up bridges for your region.
            </p>
            <p class="text-hint text-xs">
              The guide is in the app, because a website is unreachable from the network blocking you.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 03 ARCHITECTURE (the crypto proof, kept) ─────────────────────────── -->
  <section id="architecture" class="relative py-28 px-6 max-w-4xl mx-auto overflow-hidden">
    <div aria-hidden="true" class="absolute top-0 left-1/2 -translate-x-1/2 w-[80%] h-72 bg-accent/[0.06] blur-3xl pointer-events-none"></div>
    <div class="relative">
      <div class="section-reveal text-center mb-12">
        <SectionEyebrow num="03" label="CRYPTO" />
        <h2 class="text-3xl md:text-5xl font-light text-primary mb-4 tracking-tight">Plaintext that never leaves the two phones</h2>
        <p class="text-secondary max-w-xl mx-auto">
          No new cryptography was designed for Whispr, deliberately: rolling your own is how people who trusted a messenger get hurt, so this is Signal's published design implemented against their spec.
        </p>
      </div>

      <div class="section-reveal mb-12">
        <ArchitectureDiagram />
      </div>

      <div class="section-reveal font-mono text-sm rounded-2xl bg-bg border border-border overflow-hidden">
        <div class="flex items-center gap-2 px-5 py-3 border-b border-border bg-surface">
          <div class="w-3 h-3 rounded-full bg-error/70"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
          <div class="w-3 h-3 rounded-full bg-accent/70"></div>
          <span class="ml-2 text-hint text-xs">security-architecture.txt</span>
        </div>
        <div class="p-6 space-y-2.5 text-xs md:text-sm leading-relaxed overflow-x-auto">
          {[
            ['Identity',         'Ed25519 key pair · generated on-device · stored in hardware enclave'],
            ['Key Exchange',     'X3DH (Extended Triple Diffie-Hellman) · forward secrecy'],
            ['Message Crypto',   'Double Ratchet · AES-256-GCM · per-message keys'],
            ['Transport Crypto', 'ECIES outer envelope · AES-GCM UDP discovery'],
            ['Email Crypto',     'ECIES pairwise encryption to recipient Ed25519 identity key'],
            ['Database',         'SQLCipher · AES-256 · full file encryption on mobile'],
            ['Password',         'PBKDF2-SHA512 · 200,000 iterations · 256-bit key'],
            ['Metadata',         'Random padding · ECIES envelope · sender/receiver hidden on wire'],
            ['Server',           'None'],
          ].map(([key, val]) => (
            <div class="flex gap-4 items-baseline">
              <span class="text-hint shrink-0 w-36">{key}</span>
              <span class="text-accent">→</span>
              <span class="text-primary/80">{val}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── 04 ROADMAP ───────────────────────────────────────────────────────── -->
  <section id="roadmap" class="relative py-24 px-6 max-w-4xl mx-auto">
    <div aria-hidden="true" class="absolute top-0 right-0 w-[50%] h-64 bg-accent/[0.05] blur-3xl pointer-events-none"></div>
    <div class="section-reveal text-center mb-14">
      <SectionEyebrow num="04" label="NEXT" />
      <h2 class="text-3xl md:text-5xl font-black text-primary mb-4">Not finished yet</h2>
    </div>

    <div class="space-y-4">
      {[
        // The v1.1.14 changelog entry promised obfs4 for v1.1.15 and v1.1.15 shipped the in-app bridges guide instead.
        // CONFIRM: the reason it slipped, most likely packaging a pluggable-transport binary inside the APK.
        { tag: 'IN PROGRESS', title: 'obfs4 bridge transport', body: 'obfs4 hides Tor traffic from deep-packet inspection by making it look like ordinary TLS; vanilla bridges shipped in v1.1.14 and obfs4 was meant to follow in v1.1.15, which it did not.', status: 'building' },
        { tag: 'IN PROGRESS', title: 'Voice & video calls', body: 'None of this works yet. Latency over Tor and NAT traversal without a relay are both unsolved.', status: 'building' },
        // CONFIRM: whether group-key rotation on member exit is the blocker, or only one of them.
        { tag: 'PLANNED', title: 'Group messaging', body: 'Rotating the key when someone leaves is the unsolved part. Everything else is a shared group key derived between the members.', status: 'planned' },
        { tag: 'PLANNED', title: 'Self-destructing messages', body: 'Per-message timers that delete on both devices when they expire, though a screenshot beats them.', status: 'planned' },
      ].map(({ tag, title, body, status }) => {
        const cardBorder =
          status === 'building' ? 'border-accent/40 hover:border-accent/60 shadow-[0_0_24px_rgba(0,212,170,0.06)]'
          :                       'border-border hover:border-accent/20';
        const dot = status === 'building' ? 'bg-accent animate-pulse' : 'bg-hint';
        const pill =
          status === 'building' ? 'bg-accent/10 text-accent border border-accent/30'
          :                       'bg-surface text-hint border border-border';
        const label = status === 'building' ? 'building' : 'planned';
        return (
          <div class={`section-reveal flex gap-5 p-6 rounded-2xl bg-surface border transition-colors ${cardBorder}`}>
            <div class={`mt-1 w-2 h-2 rounded-full shrink-0 ${dot}`}></div>
            <div>
              <p class="text-hint text-xs font-mono mb-1">{tag}</p>
              <h3 class="text-base font-bold text-primary mb-1.5">{title}</h3>
              <p class="text-secondary text-sm leading-relaxed">{body}</p>
            </div>
            <div class={`ml-auto shrink-0 self-start px-2 py-0.5 rounded text-xs font-mono ${pill}`}>
              {label}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <Footer />
</Base>

<script>
  // Download counter, fetched client-side from the GitHub Releases API.
  // Hidden until total downloads ≥ 1000. Cached 1h in localStorage.
  // Single fetch to a public endpoint, no third-party analytics.
  const REPO    = 'pointbreaklab-hub/Whispr';
  const KEY     = 'pbl_dl_count_v1';
  const TTL_MS  = 60 * 60 * 1000;
  const REVEAL  = 1000;

  function readCache(): number | null {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return null;
      const { count, ts } = JSON.parse(raw);
      if (typeof count !== 'number' || typeof ts !== 'number') return null;
      if (Date.now() - ts > TTL_MS) return null;
      return count;
    } catch {
      return null;
    }
  }

  function writeCache(count: number) {
    try {
      localStorage.setItem(KEY, JSON.stringify({ count, ts: Date.now() }));
    } catch { /* private mode / disabled, silently skip */ }
  }

  async function fetchTotalDownloads(): Promise<number> {
    const res = await fetch(`https://api.github.com/repos/${REPO}/releases`);
    if (!res.ok) throw new Error(`GitHub API ${res.status}`);
    const releases = await res.json() as Array<{ assets: Array<{ download_count: number }> }>;
    return releases.reduce(
      (sum, r) => sum + r.assets.reduce((s, a) => s + (a.download_count || 0), 0),
      0,
    );
  }

  function reveal(count: number) {
    if (count < REVEAL) return;
    const el = document.getElementById('download-count');
    if (!el) return;
    el.textContent = `${count.toLocaleString()} downloads`;
    el.classList.remove('hidden');
  }

  (async () => {
    const cached = readCache();
    if (cached != null) reveal(cached);
    try {
      const fresh = await fetchTotalDownloads();
      writeCache(fresh);
      reveal(fresh);
    } catch { /* offline or rate-limited, leave as-is */ }
  })();
</script>
