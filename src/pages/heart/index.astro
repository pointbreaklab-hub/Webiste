---
import Base           from '../../layouts/Base.astro';
import Nav            from '../../components/Nav.astro';
import FeatureBlock   from '../../components/FeatureBlock.astro';
import DownloadButton from '../../components/DownloadButton.astro';
import Footer         from '../../components/Footer.astro';
import HeartArchitectureDiagram from '../../components/HeartArchitectureDiagram.astro';
import SectionEyebrow from '../../components/SectionEyebrow.astro';
import '../../styles/global.css';

// LEAN REWRITE 2026-07-28 (owner: "too much content is a dead end"). Heart was
// the longest page (713 lines). Same treatment as Knot/Whispr: 8 -> 4 features;
// the 5-slide carousel -> 1 static shot; CUT the "band is just a sensor" prose
// + Coospo-vs-Heart comparison table; the deep architecture (pipeline, RMSSD
// math, 23-row formula reference) collapsed behind ONE toggle; download pulled
// up from section 4 to section 2. KEPT the auditable-algorithm proof visible
// (diagram + 84-case validation card + honest disclaimers) — for Heart that IS
// the pitch. Do NOT restore the removed sections.
---

<Base
  title="Heart · Local-first wellness app for Bluetooth heart-rate bands"
  description="A wellness app for Bluetooth heart-rate bands. Tracks HR, HRV, sleep stages, recovery, and strain, entirely on your device. No account, no cloud, no subscription. Pairs with the Coospo HW9 (worn on the chest or arm) and any standard BLE chest strap."
>
  <Nav />

  <!-- ── HERO ─────────────────────────────────────────────────────────────── -->
  <section class="relative pt-32 pb-16 px-6 overflow-hidden">
    <div aria-hidden="true" class="absolute top-0 left-1/2 -translate-x-1/2 w-[80%] h-[28rem] bg-accent/[0.08] blur-3xl pointer-events-none"></div>
    <div aria-hidden="true" class="absolute top-1/3 right-0 w-72 h-72 bg-blue-500/[0.04] blur-3xl pointer-events-none"></div>

    <div class="relative max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-accent/30 bg-accent/5 text-accent text-xs font-mono tracking-wider mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        HEART · LOCAL-FIRST WELLNESS
      </div>

      <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-[1.05] mb-6">
        <span class="text-primary">Your heart,</span><br/>
        <span class="text-gradient">on your device.</span>
      </h1>

      <p class="text-lg text-secondary font-light max-w-xl mx-auto leading-relaxed mb-3">
        A wellness app for Bluetooth heart-rate bands. Tracks HR, HRV, sleep, recovery, and strain, entirely on your device. No account, no cloud, no subscription.
      </p>
      <p class="text-sm text-hint font-mono mb-10">
        Free · on-device · auditable.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#download"
          class="px-8 py-3.5 rounded-xl bg-accent text-bg font-bold text-sm hover:bg-white transition-all hover:scale-105 hover:shadow-[0_0_32px_rgba(0,212,170,0.4)]"
        >
          Download for Android
        </a>
        <a
          href="#architecture"
          class="px-8 py-3.5 rounded-xl border border-border text-secondary text-sm hover:border-accent hover:text-primary transition-all"
        >
          See the algorithms
        </a>
      </div>
    </div>
  </section>

  <!-- ── PRODUCT SHOT (single static phone, was a 5-slide carousel) ───────── -->
  <section class="relative pb-24 px-6 overflow-hidden">
    <div aria-hidden="true" class="absolute top-0 right-1/4 w-[40%] h-64 bg-accent/[0.05] blur-3xl pointer-events-none"></div>
    <div class="max-w-lg mx-auto section-reveal flex justify-center">
      <div class="relative" style="width:260px">
        <div class="absolute" style="left:-3px;top:88px;width:3px;height:28px;background:#2a2a35;border-radius:2px 0 0 2px"></div>
        <div class="absolute" style="left:-3px;top:128px;width:3px;height:48px;background:#2a2a35;border-radius:2px 0 0 2px"></div>
        <div class="absolute" style="right:-3px;top:108px;width:3px;height:36px;background:#2a2a35;border-radius:0 2px 2px 0"></div>
        <div class="rounded-[38px] border-2 border-[#23232a] bg-[#0e0e11] p-2.5"
             style="box-shadow:0 32px 80px rgba(0,0,0,0.8),0 0 0 1px rgba(255,255,255,0.025)">
          <div class="rounded-[30px] overflow-hidden" style="aspect-ratio:9/19.4">
            <img src="/screenshots/heart/flutter_01.png" alt="Heart home screen showing 104 bpm live heart rate with a zone-2 indicator" loading="lazy" class="w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 01 WHAT IT DOES (4 features + hardware) ──────────────────────────── -->
  <section id="features" class="relative py-24 px-6 max-w-6xl mx-auto">
    <div aria-hidden="true" class="absolute top-0 left-1/4 w-[40%] h-72 bg-accent/[0.06] blur-3xl pointer-events-none"></div>

    <div class="section-reveal text-center mb-14">
      <SectionEyebrow num="01" label="WHAT IT DOES" />
      <h2 class="text-3xl md:text-5xl font-black text-primary mb-4">What it does</h2>
      <p class="text-secondary max-w-xl mx-auto leading-relaxed">
        All on-device. No subscription, no cloud, no black box.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-20">
      <FeatureBlock
        icon="❤️"
        title="Live HR + HRV"
        description="Continuous heart rate, zones, and RMSSD heart-rate variability, computed directly from R–R intervals using the 1996 ESC/NASPE standard."
      />
      <FeatureBlock
        icon="🌙"
        title="Sleep, recovery & strain"
        description="Four-stage sleep from overnight HR, a WHOOP-style recovery score (HRV percentile vs your 30-day baseline), and zone-weighted strain. All from published methodology, not black boxes."
      />
      <FeatureBlock
        icon="🧠"
        title="On-device intelligence"
        description="A readiness forecast for tomorrow's HRV, rhythm-anomaly detection, and post-workout summaries with GPS routes, zones, and recovery impact, all computed on your phone."
      />
      <FeatureBlock
        icon="🚫"
        title="No account, no cloud"
        description="Everything stays on your device: samples, scores, sleep history. One-tap JSON export for migration, one-tap delete-everything."
      />
    </div>

    <!-- Hardware compatibility (compressed from a full section). -->
    <div class="section-reveal">
      <p class="text-accent text-xs font-mono tracking-widest mb-3 text-center">HARDWARE</p>
      <h3 class="text-2xl md:text-3xl font-black text-primary mb-4 text-center">Pairs with the band you already own.</h3>
      <p class="text-secondary max-w-2xl mx-auto mb-10 text-center leading-relaxed text-sm">
        Heart speaks the standard BLE Heart Rate Service (UUID 0x180D). Pair once, wear it 24/7, get insights every morning.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          { icon: '🟢', label: 'PRIMARY',  title: 'Coospo HW9',   body: 'Worn on the chest, upper arm, or forearm. Full support: live HR, RR-interval HRV, battery reporting. Heart was built and tested with this band.' },
          { icon: '🔵', label: 'STANDARD', title: 'Any BLE strap', body: 'Polar H10, Wahoo TICKR, Garmin HRM-Dual, anything speaking Heart Rate Service 0x180D + Measurement 0x2A37.' },
          { icon: '🟡', label: 'OPTICAL',  title: 'Wrist sensors', body: 'Live HR works on optical wrist straps, but RR-interval availability varies, so HRV is coarser than from a chest strap.' },
        ].map(({ icon, label, title, body }) => (
          <div class="p-6 rounded-2xl bg-surface border border-border hover:border-accent/30 transition-colors text-center group">
            <div class="text-4xl mb-4">{icon}</div>
            <div class="inline-block px-2 py-0.5 rounded bg-accent/10 text-accent text-xs font-mono mb-3">{label}</div>
            <h4 class="text-base font-bold text-primary mb-2">{title}</h4>
            <p class="text-secondary text-sm leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 02 GET IT (moved up from section 4) ──────────────────────────────── -->
  <section id="download" class="relative py-28 px-6 bg-surface border-y border-border overflow-hidden">
    <div aria-hidden="true" class="absolute top-0 left-1/2 -translate-x-1/2 w-[70%] h-80 bg-accent/[0.10] blur-3xl pointer-events-none"></div>
    <div class="relative max-w-2xl mx-auto">
      <div class="section-reveal text-center">
        <SectionEyebrow num="02" label="GET IT" />
        <h2 class="text-3xl md:text-5xl font-black text-primary mb-4">Download Heart</h2>
        <p class="text-secondary mb-10">Available for Android. iOS coming soon. Pair your band, wear it 24/7, get insights every morning.</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-3">
          <DownloadButton
            platform="android"
            href="https://github.com/pointbreaklab-hub/Heart/releases/latest/download/heart-android.apk"
            label="Android APK"
          />
          <DownloadButton platform="ios" href="#" label="iOS, Coming Soon" />
        </div>

        <div class="text-left p-5 rounded-2xl bg-bg border border-border font-mono text-xs space-y-1.5">
          <div class="flex gap-3"><span class="text-hint w-32">Version</span><span class="text-primary">1.0.22</span></div>
          <div class="flex gap-3"><span class="text-hint w-32">Min Android</span><span class="text-primary">7.0 · API 24</span></div>
          <div class="flex gap-3"><span class="text-hint w-32">Cost</span><span class="text-primary/80">Free. No accounts, no ads, no tracking.</span></div>
          <div class="flex gap-3 mt-3 pt-3 border-t border-border"><span class="text-hint w-32">SHA-256 (APK)</span><span class="text-primary/60 break-all">d56b58f6684e2144b7c687e0d183b93737c494500a9585ebf4aa2f70f281f958</span></div>
        </div>

        <p class="text-hint text-xs mt-4">
          Full release history: <a href="/heart/changelog/" class="text-accent hover:underline">changelog</a>
          &nbsp;·&nbsp;
          <a href="/heart/privacy/" class="text-accent hover:underline">privacy policy</a>
        </p>
      </div>

      <!-- Why chest-strap accuracy beats wrist optical (a real differentiator). -->
      <div class="section-reveal mt-12 p-6 rounded-2xl bg-bg border border-border">
        <div class="flex items-start gap-4">
          <div class="shrink-0 w-10 h-10 rounded-xl bg-accent/10 border border-accent/30 flex items-center justify-center text-xl">📏</div>
          <div>
            <p class="text-accent text-xs font-mono tracking-widest mb-2">ACCURACY · CHEST STRAP VS WRIST</p>
            <h3 class="text-lg font-bold text-primary mb-2">Better signal in, better signal out.</h3>
            <p class="text-secondary text-sm leading-relaxed mb-3">
              Published literature puts wrist optical sensors at <span class="text-primary">±5–15 bpm</span> against ECG during effort and <span class="text-primary">±10–20 ms</span> on overnight HRV. Chest straps as a category reach <span class="text-accent">±2 bpm</span> and <span class="text-accent">±3–5 ms</span>. Heart pairs with a chest strap by default, so the input it computes from is fundamentally cleaner.
            </p>
            <p class="text-hint text-xs">
              Same algorithmic class as WHOOP and Oura for derived scores, without the subscription, the cloud, or the closed source.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 03 ARCHITECTURE (auditable algorithms; deep detail behind a toggle) ── -->
  <section id="architecture" class="relative py-28 px-6 max-w-4xl mx-auto overflow-hidden">
    <div aria-hidden="true" class="absolute top-0 left-1/2 -translate-x-1/2 w-[80%] h-72 bg-accent/[0.06] blur-3xl pointer-events-none"></div>
    <div class="relative">
      <div class="section-reveal text-center mb-14">
        <SectionEyebrow num="03" label="ARCHITECTURE" />
        <h2 class="text-3xl md:text-5xl font-light text-primary mb-4 tracking-tight">A time-series engine,<br/>not an AI black box.</h2>
        <p class="text-secondary max-w-2xl mx-auto leading-relaxed">
          Heart ingests raw R–R intervals off a BLE characteristic, runs classical signal processing on a 300-sample sliding window, and produces auditable scores. No neural network, no model weights, no remote inference. Every formula traces to a published paper.
        </p>
      </div>

      <div class="section-reveal mb-12">
        <HeartArchitectureDiagram />
      </div>

      <!-- Validation card — the killer credibility signal, kept visible. -->
      <div class="section-reveal mb-6 p-5 rounded-2xl bg-bg border border-accent/30">
        <div class="flex items-start gap-3">
          <div class="shrink-0 w-9 h-9 rounded-lg bg-accent/15 border border-accent/40 flex items-center justify-center text-base">✓</div>
          <div class="min-w-0 w-full">
            <p class="text-accent text-xs font-mono tracking-widest mb-1.5">VALIDATION · 13 ALGORITHMS · 84 TEST CASES</p>
            <p class="text-primary text-sm leading-relaxed mb-3">
              Every closed-form algorithm in Heart produces output <span class="text-accent">matching the numpy reference</span> (the backend behind pyhrv, hrv-analysis, and Kubios HRV) to floating-point precision: global maximum deviation <span class="text-accent font-mono">1.42 × 10⁻¹⁴</span>, at the IEEE-754 double-precision noise floor.
            </p>
            <p class="text-secondary text-xs leading-relaxed">
              Reproducible via <span class="text-primary/70 font-mono text-[11px]">flutter test test/algorithm_validation_test.dart</span>. Because every formula is closed-form (Tanaka 2001, Uth 2004, Keytel 2005, Holt 1957, ESC/NASPE 1996, Banister 1975, Coyle 1998), "matches numpy" equals "matches Kubios" by mathematical identity.
            </p>
          </div>
        </div>
      </div>

      <!-- Deep technical reference (pipeline + math + formula table) behind ONE toggle. -->
      <details class="group section-reveal rounded-2xl border border-border overflow-hidden mb-8">
        <summary class="flex items-center justify-between gap-4 px-5 py-3.5 bg-surface cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-surface/60 transition-colors">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-error/70"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
            <div class="w-3 h-3 rounded-full bg-accent/70"></div>
            <span class="ml-2 text-hint text-xs font-mono">pipeline-math-and-references.txt</span>
          </div>
          <div class="flex items-center gap-2 font-mono text-xs select-none">
            <span class="text-secondary">The pipeline, the math, every reference</span>
            <span class="text-accent group-open:hidden">▶</span>
            <span class="text-accent hidden group-open:inline">▼</span>
          </div>
        </summary>

        <div class="border-t border-border bg-bg">
          <!-- THE PIPELINE -->
          <div class="px-6 pt-8 pb-6">
            <p class="text-accent text-xs font-mono tracking-widest mb-8 text-center">RAW BYTES → RECOVERY SCORE</p>
            <div class="max-w-2xl mx-auto">
              {[
                { tag: 'STEP 1 · BLE INGEST', title: 'BLE 0x2A37 notify frame', detail: 'flags[0] | bpm[1] | RR_low[2] | RR_high[3] …   ·   ~1 notify / sec', sub: 'bit1(flags) == 1  →  RR values present in frame', accent: true },
                { tag: 'STEP 2 · PARSE', title: 'RR interval extractor', detail: 'uint16_le(frame[i], frame[i+1])  /  1024.0  ×  1000  →  ms', sub: 'physiological gate: discard RR outside [300 ms, 2000 ms]', accent: true },
                { tag: 'STEP 3 · PERSIST', title: 'JSONL log  ·  heart_samples/YYYY-MM-DD.jsonl', detail: '{"ts_ms": 1715608800000, "bpm": 72, "rr_ms": [812, 819, 808]}', sub: 'appended live · sandboxed app storage · OS-encrypted at rest', accent: false },
                { tag: 'STEP 4 · HRV', title: '300-sample ring buffer  →  RMSSD', detail: 'RMSSD = √( Σ(RRᵢ₊₁ − RRᵢ)²  /  (N − 1) )   [N ≥ 4]', sub: 'ESC/NASPE Task Force · Eur. Heart J. 17:354–381 · 1996', accent: true },
                { tag: 'STEP 5 · SLEEP', title: 'Deterministic four-stage classifier  ·  5-min HR buckets', detail: 'mean_bpm < baseline + 8  →  sleep candidate', sub: 'onset gate 0.70 · stability σ < 6 bpm · awake / light / deep / REM · heuristics over ML: overnight tflite inference would drain phone + band battery', accent: false },
                { tag: 'STEP 6 · BASELINE', title: 'OvernightBaselineComputer  ·  30-day rolling window', detail: 'RMSSD_array[−30 … −1]  →  percentile rank of last night', sub: 'recovery = floor( rank × 100 )   ·   strain = zone-weighted effort Σ', accent: true },
              ].map((step, i, arr) => (
                <div>
                  <div class={`rounded-xl border p-4 font-mono text-xs ${step.accent ? 'border-accent/40 bg-bg' : 'border-border bg-bg/60'}`}>
                    <p class="text-hint tracking-widest mb-1.5">{step.tag}</p>
                    <p class={`text-sm mb-1 ${step.accent ? 'text-accent' : 'text-primary/80'}`}>{step.title}</p>
                    <p class="text-primary/60 leading-relaxed">{step.detail}</p>
                    <p class="text-hint mt-1 leading-relaxed">{step.sub}</p>
                  </div>
                  {i < arr.length - 1 && (
                    <div class="flex justify-center py-3 text-accent/60 text-lg select-none">↓</div>
                  )}
                </div>
              ))}
            </div>
          </div>

          <div class="border-t border-border mx-6"></div>

          <!-- FORMULA REFERENCE -->
          <div class="px-6 pt-8 pb-8">
            <p class="text-accent text-xs font-mono tracking-widest mb-6 text-center">EVERY FORMULA, EVERY SOURCE</p>
            <div class="p-2 space-y-2.5 text-xs leading-relaxed overflow-x-auto">
              {[
                ['HRV',              'RMSSD · ESC/NASPE Task Force · Eur. Heart J. 17:354 · 1996'],
                ['HRmax',            'Age-predicted max · Tanaka et al. · Med. Sci. Sports Exerc. 32:1591 · 2001'],
                ['HR zones',         '5-zone partition · HRmax × [0.60, 0.70, 0.80, 0.90]'],
                ['VO2max',           'Heart-rate ratio method · Uth et al. · Eur. J. Appl. Physiol. 91:111 · 2004'],
                ['Calories',         'HR + age + weight + sex · Keytel et al. · J. Sports Sci. 23:289 · 2005'],
                ['Distance',         'Haversine great-circle · spherical-earth approximation'],
                ['Cardiac drift',    'Early-third vs late-third HR · Coyle framework · 1998'],
                ['Strain',           'TRIMP zone-weighted load · Banister & Calvert · 1975'],
                ['Sleep stages',     'Rule-based 5-min HR-bucket classifier · 4 stages'],
                ['Sleep priors',     'Bayesian post-hoc correction · Sleep-EDF · Kemp et al. 2000'],
                ['Recovery',         'WHOOP-style composite · HRV percentile vs 30-day baseline'],
                ['Readiness',        'Holt linear exponential smoothing · Holt · ONR memo 52 · 1957'],
                ['Rhythm hint',      '4-feature thresholding · pNN50 + CoV(RR) + RMSSD + RR range'],
                ['Storage',          'SharedPreferences + JSONL · app sandbox · OS-encrypted'],
                ['Network',          'None, only optional OSM tile downloads for offline maps'],
                ['Server',           'None'],
              ].map(([key, val]) => (
                <div class="flex gap-4 items-baseline font-mono">
                  <span class="text-hint shrink-0 w-32">{key}</span>
                  <span class="text-accent">→</span>
                  <span class="text-primary/80">{val}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </details>

      <!-- Compressed 2026-07-29 (6 sentences -> 3). Both jobs preserved: the
           overclaim guard (validation proves the ALGORITHM, not end-to-end
           accuracy) and the MDR safe-harbour line (wellness app, not a medical
           device, not for diagnosis). Don't cut the medical-device sentence. -->
      <p class="text-hint text-xs text-center max-w-xl mx-auto leading-relaxed">
        The validation above proves the <span class="text-secondary">algorithm</span>, not end-to-end accuracy: sleep staging vs PSG and calories vs calorimetry haven't been independently measured yet. Heart is a wellness application, not a medical device. Scores are estimates from consumer-grade sensors, built for tracking trends, not diagnosis.
      </p>
    </div>
  </section>

  <!-- ── 04 ROADMAP ───────────────────────────────────────────────────────── -->
  <section id="roadmap" class="relative py-24 px-6 max-w-4xl mx-auto">
    <div aria-hidden="true" class="absolute top-0 right-0 w-[50%] h-64 bg-accent/[0.05] blur-3xl pointer-events-none"></div>
    <div class="section-reveal text-center mb-14">
      <SectionEyebrow num="04" label="ROADMAP" />
      <h2 class="text-3xl md:text-5xl font-black text-primary mb-4">What's coming</h2>
    </div>

    <div class="space-y-4">
      {[
        { tag: 'IN PROGRESS', title: 'Personal heart-age calibration', body: 'Replace static population-norm tables with a personal regression fit once 30+ nights of baseline data exist, surfaced in the UI when calibration is reliable.', status: 'building' },
        { tag: 'PLANNED', title: 'Sleep stager validation against PSG', body: 'Validate the rule-based + prior-calibrated stager against published polysomnography datasets and tighten it where deltas exceed ±10 minutes per stage.', status: 'planned' },
      ].map(({ tag, title, body, status }) => {
        const cardBorder = status === 'building' ? 'border-accent/40 hover:border-accent/60 shadow-[0_0_24px_rgba(0,212,170,0.06)]' : 'border-border hover:border-accent/20';
        const dot = status === 'building' ? 'bg-accent animate-pulse' : 'bg-hint';
        const pill = status === 'building' ? 'bg-accent/10 text-accent border border-accent/30' : 'bg-surface text-hint border border-border';
        const label = status === 'building' ? 'building' : 'planned';
        return (
          <div class={`section-reveal flex gap-5 p-6 rounded-2xl bg-surface border transition-colors ${cardBorder}`}>
            <div class={`mt-1 w-2 h-2 rounded-full shrink-0 ${dot}`}></div>
            <div>
              <p class="text-hint text-xs font-mono mb-1">{tag}</p>
              <h3 class="text-base font-bold text-primary mb-1.5">{title}</h3>
              <p class="text-secondary text-sm leading-relaxed">{body}</p>
            </div>
            <div class={`ml-auto shrink-0 self-start px-2 py-0.5 rounded text-xs font-mono ${pill}`}>
              {label}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <Footer />
</Base>
