---
// OPEN QUESTIONS for the owner, parked here so they do not render on the page:
//   - real battery life and reconnect delay
//   - the source for these wrist figures
//   - what WHOOP publishes about its sensor validation
//   - (answered 2026-09-28: validation re-run, 92 cases / 14 algorithms, max Δ 1.42e-14)
//   - is this blocked on dataset access, and which corpus?
import Base           from '../../layouts/Base.astro';
import Nav            from '../../components/Nav.astro';
import DownloadButton from '../../components/DownloadButton.astro';
import Footer         from '../../components/Footer.astro';
import HeartArchitectureDiagram from '../../components/HeartArchitectureDiagram.astro';
import SectionEyebrow from '../../components/SectionEyebrow.astro';
import '../../styles/global.css';

// LANDING REWRITE 2026-09-28 (owner: "we still don't have a good landing
// page"). Replaces the 2026-07-28 lean page. Structure, top to bottom:
//   Hero (value prop + direct APK CTA + real Home screenshot)
//   01 WORKS WITH YOUR STRAP  (HW9 chest / upper arm / forearm + any 0x180D strap)
//   02 WHAT IT DOES           (3 spotlights with CSS/SVG mockups + 6-item grid)
//   03 GET IT                 (download box: version + SHA-256, unchanged link)
//   04 INSTALL HELP           (sideload steps, Samsung Auto Blocker, Play Protect)
//   05 PRIVACY                (on-device guarantees + diagram + validation card)
//   06 FAQ                    (native <details>, mirrored into FAQPage JSON-LD)
// Rules still in force from the lean rewrite: download reachable from the hero
// and at chapter 03; the architecture diagram + validation card stay VISIBLE;
// deep maths stays behind ONE <details>; never cut the disclaimers; never call
// the HW9 chest-only. Mockups are illustrations and are captioned as such —
// the only real screenshot is the Home screen in the hero.

// Keep this EXACT: GitHub Releases auto-resolves "latest" to the newest asset.
const APK_URL = 'https://github.com/pointbreaklab-hub/Heart/releases/latest/download/heart-android.apk';
const VERSION = '1.0.22';
const APK_SHA256 = 'd56b58f6684e2144b7c687e0d183b93737c494500a9585ebf4aa2f70f281f958';
const APK_SIZE = '~82 MB';

// Shared keyboard focus ring (the site had none on this page's controls).
const focusRing = 'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg';

// ── Illustrative hypnogram (example night, NOT user data) ─────────────────
// Stage rows: 0 awake · 1 REM · 2 light · 3 deep. Units are 5-minute buckets,
// matching the app's stager resolution.
const stageMeta = [
  { key: 'awake', label: 'Awake', color: '#f59e0b' },
  { key: 'rem',   label: 'REM',   color: '#a78bfa' },
  { key: 'light', label: 'Light', color: '#60a5fa' },
  { key: 'deep',  label: 'Deep',  color: '#00d4aa' },
];
const night: [number, number][] = [
  [2,3],[3,6],[2,4],[1,2],[2,5],[3,5],[2,3],[0,1],[2,4],[1,4],
  [2,6],[3,3],[2,4],[1,5],[2,5],[0,1],[2,3],[1,6],[2,3],[0,2],
];
const totalUnits = night.reduce((s, [, u]) => s + u, 0);
const hypW = 320, rowH = 26, barH = 12, hypTop = 6;
let cursor = 0;
const hypSegments = night.map(([stage, units]) => {
  const x = (cursor / totalUnits) * hypW;
  const w = (units / totalUnits) * hypW;
  cursor += units;
  const y = hypTop + stage * rowH + (rowH - barH) / 2;
  return { x, w, y, color: stageMeta[stage].color, stage };
});
// Thin connector line tracing stage changes.
const hypPath = hypSegments
  .map((s, i) => `${i === 0 ? 'M' : 'L'}${s.x.toFixed(1)},${(s.y + barH / 2).toFixed(1)} L${(s.x + s.w).toFixed(1)},${(s.y + barH / 2).toFixed(1)}`)
  .join(' ');
const stageMinutes = stageMeta.map((m, idx) => ({
  ...m,
  minutes: night.filter(([s]) => s === idx).reduce((a, [, u]) => a + u * 5, 0),
}));
const fmtHM = (min: number) => (min < 60 ? `${min}m` : `${Math.floor(min / 60)}h ${String(min % 60).padStart(2, '0')}m`);
const asleepMinutes = stageMinutes.filter((s) => s.key !== 'awake').reduce((a, s) => a + s.minutes, 0);

// ── FAQ (rendered + mirrored into JSON-LD so they never drift) ────────────
const faqs: { q: string; a: string; href?: { url: string; text: string } }[] = [
  {
    q: 'Do I need the Coospo HW9?',
    a: 'No. I built Heart around the Coospo HW9, which you can wear on the chest, upper arm or forearm, but any strap that sends the standard Bluetooth Heart Rate Service works, such as the Polar H9 and H10, Garmin HRM-Dual or Wahoo TICKR. A user has confirmed the Polar H9.',
  },
  {
    q: 'Is there an iPhone version?',
    a: 'No. Heart runs on Android 7.0 or newer only.',
  },
  {
    q: 'Does any of my data leave my phone?',
    a: 'Only what you choose to send. Every score is computed on the phone, and Heart has no account, server or telemetry. The app fetches OpenStreetMap map tiles. Google Drive backup, the Coach model download and phone-to-phone sync over Wi-Fi only run if you turn them on.',
  },
  {
    q: 'What happens to my data if I uninstall or change phones?',
    a: 'Heart writes its backups to Download/Heart on the phone, and that folder is kept when you uninstall. After a reinstall, point Heart at that folder, or at a backup file you copied off the phone, and your history comes back. Nothing newer than the last backup comes back, so leave the automatic backups on. To update, install the new APK over the old one; your data is kept.',
  },
  {
    q: 'Do I need an account?',
    a: 'No. Accept the wellness disclaimer, pair your band, and it starts recording.',
  },
  {
    q: 'Is Heart a medical device?',
    a: 'No. Heart shows wellness estimates from a consumer-grade heart-rate band. They are not medical advice or a diagnosis. Irregular-rhythm hints in particular only mean something looked unusual; talk to a qualified healthcare professional about anything that worries you.',
  },
  {
    q: 'Why does Android warn me when I install it?',
    a: 'Heart is installed from an APK file rather than an app store, so Android asks you to confirm the source the first time. The install steps above cover the prompts people have run into, including Samsung Auto Blocker and Play Protect.',
    href: { url: '#install', text: 'See the install steps' },
  },
];

const heartJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Heart',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Android 7.0+',
  softwareVersion: VERSION,
  description: 'HRV, sleep stages, recovery and strain from a Bluetooth heart-rate band, computed on the phone. No account and no server.',
  downloadUrl: APK_URL,
  publisher: { '@type': 'Organization', name: 'PointBreakLab' },
};
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Base
  title="Heart · HRV, sleep and recovery from a Bluetooth heart-rate band"
  description="Android app that reads the R–R intervals off a Bluetooth heart-rate band and works out HRV, sleep stages, recovery and strain on the phone. Built with the Coospo HW9 (chest, upper arm or forearm); other straps that send the standard Heart Rate Service work too. No account and no server."
>
  <Nav />
  <script type="application/ld+json" set:html={JSON.stringify(heartJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <main>
  <!-- ── HERO ─────────────────────────────────────────────────────────────── -->
  <section class="relative pt-28 md:pt-36 pb-20 px-6 overflow-hidden">
    <div aria-hidden="true" class="absolute top-0 left-1/2 -translate-x-1/2 w-[80%] h-[28rem] bg-accent/[0.08] blur-3xl pointer-events-none"></div>
    <div aria-hidden="true" class="absolute top-1/3 right-0 w-72 h-72 bg-blue-500/[0.05] blur-3xl pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-14 lg:gap-10 items-center">
      <div class="text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-accent/30 bg-accent/5 text-accent text-xs font-mono tracking-wider mb-8">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          HEART · FOR ANDROID
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight leading-[1.05] mb-6">
          <span class="text-primary">HRV, sleep and recovery,</span><br/>
          <span class="text-gradient">computed on the phone.</span>
        </h1>

        <p class="text-lg md:text-xl text-secondary font-light max-w-xl mx-auto lg:mx-0 leading-relaxed mb-4">
          Heart reads the R–R intervals off a Bluetooth heart-rate band and works out <span class="text-primary">HRV, sleep stages, recovery and strain</span> from them. There is no account, and no Heart server for your data to go to.
        </p>
        <p class="text-sm text-hint font-mono mb-10">
          Coospo HW9 · Polar · Garmin · Wahoo · any 0x180D strap
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href={APK_URL}
            class={`inline-flex items-center gap-2.5 px-8 py-3.5 rounded-xl bg-accent text-bg font-bold text-sm hover:bg-white transition-all hover:scale-105 hover:shadow-[0_0_32px_rgba(0,212,170,0.4)] ${focusRing}`}
          >
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M3 13h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Download APK
          </a>
          <a
            href="#install"
            class={`px-8 py-3.5 rounded-xl border border-border text-secondary text-sm hover:border-accent hover:text-primary transition-all ${focusRing}`}
          >
            How to install
          </a>
        </div>
        <p class="text-xs text-hint font-mono mt-5">
          v{VERSION} · Android 7.0+ · {APK_SIZE} · free
        </p>
      </div>

      <!-- Real screenshot: Home tab, live heart rate. -->
      <div class="relative flex justify-center">
        <div aria-hidden="true" class="absolute inset-x-10 top-10 bottom-10 bg-accent/[0.10] blur-3xl rounded-full pointer-events-none"></div>
        <div class="relative w-[240px] sm:w-[260px]">
          <div class="rounded-[38px] border-2 border-[#23232a] bg-[#0e0e11] p-2.5"
               style="box-shadow:0 32px 80px rgba(0,0,0,0.8),0 0 0 1px rgba(255,255,255,0.025)">
            <div class="rounded-[30px] overflow-hidden" style="aspect-ratio:1080/2340">
              <img
                src="/screenshots/heart/flutter_01.png"
                width="1080" height="2340"
                alt="Heart's Home screen: a connected HW9 band at 53% battery, live heart rate of 104 bpm in zone 2 with a rolling trace, and today's active calories"
                class="w-full h-full object-cover"
                fetchpriority="high"
              />
            </div>
          </div>
          <!-- Factual callouts (no data claims), large screens only so they never overflow on phones. -->
          <div aria-hidden="true" class="hidden xl:flex absolute -left-44 top-24 items-center gap-2 px-3 py-2 rounded-xl bg-surface border border-border text-xs text-secondary font-mono shadow-lg">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span> computed on-device
          </div>
          <div aria-hidden="true" class="hidden xl:flex absolute -right-36 bottom-32 items-center gap-2 px-3 py-2 rounded-xl bg-surface border border-border text-xs text-secondary font-mono shadow-lg">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span> no account
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 01 WORKS WITH YOUR STRAP ─────────────────────────────────────────── -->
  <section id="compatibility" class="relative py-24 px-6 max-w-6xl mx-auto scroll-mt-20">
    <div aria-hidden="true" class="absolute top-0 left-1/4 w-[40%] h-72 bg-accent/[0.06] blur-3xl pointer-events-none"></div>

    <div class="relative section-reveal text-center mb-14">
      <SectionEyebrow num="01" label="THE BAND" />
      <h2 class="text-3xl md:text-5xl font-black text-primary mb-4">Which bands work</h2>
      <p class="text-secondary max-w-2xl mx-auto leading-relaxed">
        Heart reads the standard Bluetooth Heart Rate Service (0x180D), so straps from other brands work too.
      </p>
    </div>

    <div class="relative grid grid-cols-1 lg:grid-cols-2 gap-5">
      <!-- HW9 with wear positions -->
      <div class="section-reveal p-6 md:p-8 rounded-2xl bg-surface border border-accent/30 flex flex-col sm:flex-row gap-6 items-center">
        <figure class="shrink-0" aria-labelledby="wear-caption">
          <svg viewBox="0 0 160 200" width="150" height="188" role="img" aria-labelledby="wear-title">
            <title id="wear-title">Figure showing three places to wear the Coospo HW9: chest, upper arm and forearm</title>
            <!-- body silhouette -->
            <g fill="none" stroke="#3a3a44" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="80" cy="26" r="15" />
              <path d="M58 52 Q80 44 102 52 L106 118 Q80 124 54 118 Z" />
              <path d="M58 54 L40 96 L34 140" />
              <path d="M102 54 L120 96 L126 140" />
              <path d="M62 120 L60 190 M98 120 L100 190" />
            </g>
            <!-- chest band -->
            <path d="M57 72 Q80 78 103 72" stroke="#00d4aa" stroke-width="5" stroke-linecap="round" fill="none" />
            <!-- upper arm band -->
            <path d="M44 80 L54 85" stroke="#00d4aa" stroke-width="5" stroke-linecap="round" />
            <!-- forearm band -->
            <path d="M121 110 L131 112" stroke="#00d4aa" stroke-width="5" stroke-linecap="round" />
            <g font-family="JetBrains Mono, monospace" font-size="8" fill="#888888">
              <text x="80" y="92" text-anchor="middle">CHEST</text>
              <text x="4" y="70">UPPER</text><text x="4" y="79">ARM</text>
              <text x="132" y="128">FORE-</text><text x="132" y="137">ARM</text>
            </g>
          </svg>
          <figcaption id="wear-caption" class="sr-only">The HW9 can be worn on the chest, upper arm or forearm.</figcaption>
        </figure>
        <div class="text-center sm:text-left">
          <div class="inline-block px-2 py-0.5 rounded bg-accent/10 text-accent text-xs font-mono mb-3">BUILT WITH</div>
          <h3 class="text-xl font-bold text-primary mb-2">Coospo HW9</h3>
          <p class="text-secondary text-sm leading-relaxed">
            Worn on the <span class="text-primary">chest, upper arm or forearm</span>. This is the band I wear, and Heart was built and tested against it. It reports live heart rate, beat-to-beat intervals for HRV, and battery level.
          </p>
        </div>
      </div>

      <!-- Any BLE strap -->
      <div class="section-reveal p-6 md:p-8 rounded-2xl bg-surface border border-border hover:border-accent/30 transition-colors">
        <div class="inline-block px-2 py-0.5 rounded bg-accent/10 text-accent text-xs font-mono mb-3">ALSO WORKS WITH</div>
        <h3 class="text-xl font-bold text-primary mb-2">Any standard Bluetooth strap</h3>
        <p class="text-secondary text-sm leading-relaxed mb-5">
          If it broadcasts the Bluetooth Heart Rate Service (<span class="font-mono text-primary/80">0x180D</span>), Heart can read it.
        </p>
        <ul class="flex flex-wrap gap-2 mb-5" aria-label="Example compatible straps">
          {['Polar H9', 'Polar H10', 'Garmin HRM-Dual', 'Wahoo TICKR'].map((s) => (
            <li class="px-3 py-1.5 rounded-lg bg-bg border border-border text-sm text-primary/90">{s}</li>
          ))}
          <li class="px-3 py-1.5 rounded-lg border border-dashed border-border text-sm text-hint">and similar</li>
        </ul>
        <p class="text-xs text-hint leading-relaxed">
          <span class="text-accent" aria-hidden="true">✓</span> A Heart user has confirmed the Polar H9 works. HRV needs beat-to-beat (RR) intervals: a strap that doesn't send them still gives live heart rate, and optical wrist sensors report them unevenly, so their HRV is coarser.
        </p>
      </div>
    </div>
  </section>

  <!-- ── 02 WHAT IT DOES ─────────────────────────────────────────────────── -->
  <section id="features" class="relative py-24 px-6 max-w-6xl mx-auto scroll-mt-20">
    <div aria-hidden="true" class="absolute top-10 right-0 w-[45%] h-72 bg-blue-500/[0.04] blur-3xl pointer-events-none"></div>

    <div class="relative section-reveal text-center mb-16">
      <SectionEyebrow num="02" label="WHAT IT DOES" />
      <h2 class="text-3xl md:text-5xl font-black text-primary mb-4">What it works out while you wear it</h2>
      <p class="text-secondary max-w-2xl mx-auto leading-relaxed">
        Sleep and recovery come from the overnight heart rate. Gym sessions start from your saved location. Walks, runs and rides you start yourself.
      </p>
    </div>

    <div class="relative space-y-20 md:space-y-24">

      <!-- Spotlight 1: the Brief -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14 items-center">
        <div class="section-reveal">
          <p class="text-accent text-xs font-mono tracking-widest mb-3">THE BRIEF</p>
          <h3 class="text-2xl md:text-3xl font-black text-primary mb-4">The Brief tab</h3>
          <p class="text-secondary leading-relaxed mb-5">
            The Brief shows a readiness score, a suggested focus for the day, your stress, today's strain and how far you've travelled. Below it, a Holt forecast guesses tomorrow night's HRV from the last one to two weeks. It needs five nights before it starts, and it wobbles.
          </p>
          <ul class="space-y-2 text-sm text-secondary">
            <li class="flex gap-2"><span class="text-accent" aria-hidden="true">→</span>Readiness and recovery are measured against your last 30 nights</li>
            <li class="flex gap-2"><span class="text-accent" aria-hidden="true">→</span>Focus is one of push, maintain, easy or rest; strain is zone-weighted effort on a 0–21 scale</li>
            <li class="flex gap-2"><span class="text-accent" aria-hidden="true">→</span>Tap the distance line to see the day's route on a map</li>
          </ul>
        </div>

        <figure class="section-reveal">
          <div role="img" aria-label="Illustration of Heart's Brief card: readiness 71%, focus Maintain, stress Balanced, strain 6.2 out of 21, travelled 4.2 km today, tomorrow's forecast stable." class="max-w-sm mx-auto rounded-3xl bg-[#101a19] border border-[#1f2e2c] p-5 shadow-[0_24px_60px_-20px_rgba(0,0,0,0.9)]">
            <div class="flex items-center gap-2 mb-4" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#00d4aa"><path d="M12 2l1.8 5.2L19 9l-5.2 1.8L12 16l-1.8-5.2L5 9l5.2-1.8zM19 14l.9 2.1L22 17l-2.1.9L19 20l-.9-2.1L16 17l2.1-.9z"/></svg>
              <span class="text-primary text-sm font-semibold">Brief</span>
              <span class="ml-auto text-xs text-secondary">Readiness 71%</span>
            </div>
            <div class="space-y-2.5 text-sm" aria-hidden="true">
              <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-accent/10 border border-accent/25">
                <span class="w-2 h-2 rounded-full bg-accent"></span>
                <span class="text-primary font-semibold">Maintain · steady</span>
              </div>
              <div class="flex items-center gap-3 px-3 py-2">
                <span class="w-2 h-2 rounded-full bg-sky-400"></span>
                <span class="text-secondary">Stress · Balanced (42)</span>
              </div>
              <div class="flex items-center gap-3 px-3 py-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                <span class="text-secondary">Strain · 6.2 / 21 (Light day)</span>
              </div>
              <div class="flex items-center gap-3 px-3 py-2">
                <span class="w-2 h-2 rounded-full bg-violet-400"></span>
                <span class="text-secondary">Travelled 4.2 km today</span>
              </div>
            </div>
            <div class="mt-4 pt-4 border-t border-[#1f2e2c] flex items-center justify-between text-xs" aria-hidden="true">
              <span class="text-secondary">Tomorrow's forecast</span>
              <span class="px-2 py-0.5 rounded-full bg-sky-400/10 text-sky-300 border border-sky-400/25">Stable</span>
            </div>
          </div>
          <figcaption class="text-center text-[11px] text-hint font-mono mt-3">Illustration · example values</figcaption>
        </figure>
      </div>

      <!-- Spotlight 2: sleep -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14 items-center">
        <div class="section-reveal md:order-2">
          <p class="text-accent text-xs font-mono tracking-widest mb-3">SLEEP &amp; RECOVERY</p>
          <h3 class="text-2xl md:text-3xl font-black text-primary mb-4">Sleep, from overnight heart rate</h3>
          <p class="text-secondary leading-relaxed mb-5">
            Wear the band to bed. Heart looks for sleep in the overnight heart rate, in 5-minute buckets, and splits the night into awake, light, deep and REM. The stager is a set of thresholds rather than a trained model, and it hasn't been checked against a sleep lab; if a night is clearly wrong, you can correct it. Overnight HRV (RMSSD) and resting heart rate feed the recovery score, which compares last night with your previous 30.
          </p>
        </div>

        <figure class="section-reveal md:order-1">
          <div role="img" aria-label={`Illustration of a sleep hypnogram for an example night: ${fmtHM(asleepMinutes)} asleep, split into awake, REM, light and deep stages.`} class="max-w-md mx-auto rounded-3xl bg-surface border border-border p-5 md:p-6">
            <div class="flex items-baseline justify-between mb-4" aria-hidden="true">
              <div>
                <p class="text-xs text-hint font-mono tracking-widest">LAST NIGHT</p>
                <p class="text-2xl font-black text-primary">{fmtHM(asleepMinutes)}</p>
              </div>
              <p class="text-xs text-secondary font-mono">23:40 → 06:55</p>
            </div>
            <svg viewBox={`0 0 ${hypW + 44} ${hypTop * 2 + rowH * 4}`} class="w-full h-auto" aria-hidden="true">
              {stageMeta.map((m, i) => (
                <text x={hypW + 8} y={hypTop + i * rowH + rowH / 2 + 3} font-size="9" fill="#737373" font-family="JetBrains Mono, monospace">{m.label}</text>
              ))}
              {stageMeta.map((_, i) => (
                <line x1="0" x2={hypW} y1={hypTop + i * rowH + rowH / 2} y2={hypTop + i * rowH + rowH / 2} stroke="#23232a" stroke-width="1" stroke-dasharray="2 4" />
              ))}
              <path d={hypPath} stroke="#3a3a44" stroke-width="1" fill="none" />
              {hypSegments.map((s) => (
                <rect x={s.x} y={s.y} width={Math.max(s.w - 0.8, 1)} height={barH} rx="3" fill={s.color} />
              ))}
            </svg>
            <ul class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-4 text-xs" aria-hidden="true">
              {stageMinutes.map((s) => (
                <li class="flex items-center gap-1.5 text-secondary">
                  <span class="w-2 h-2 rounded-sm" style={`background:${s.color}`}></span>
                  {s.label} <span class="text-primary/80 font-mono">{fmtHM(s.minutes)}</span>
                </li>
              ))}
            </ul>
          </div>
          <figcaption class="text-center text-[11px] text-hint font-mono mt-3">Illustration · example night</figcaption>
        </figure>
      </div>

      <!-- Spotlight 3: gym + routes -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14 items-center">
        <div class="section-reveal">
          <p class="text-accent text-xs font-mono tracking-widest mb-3">WORKOUTS</p>
          <h3 class="text-2xl md:text-3xl font-black text-primary mb-4">Gym sessions start when you arrive</h3>
