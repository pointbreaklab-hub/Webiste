---
import Base   from '../../layouts/Base.astro';
import Nav    from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SectionEyebrow from '../../components/SectionEyebrow.astro';
import '../../styles/global.css';

// User-facing release log for Heart. Dev-facing detail lives on
// GitHub Releases (https://github.com/pointbreaklab-hub/Heart/releases).
//
// Style notes:
//  - Newest first.
//  - Each entry is one short paragraph in user-facing prose.
//  - Skip releases that shipped briefly and got pulled, log only what
//    users actually saw.

import { releases, latestRelease, type Release } from '../../data/heartReleases';

const fmtDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  const dt = new Date(Date.UTC(y, m - 1, d));
  return dt.toLocaleDateString('en-US', {
    month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
  });
};

const kindLabel: Record<Release['kind'], string> = {
  feature: 'FEATURE',
  fix:     'FIX',
  polish:  'POLISH',
  note:    'NOTE',
};

function eyebrowNum(tag: string): string {
  const parts = tag.replace(/^v/, '').split('.');
  const patch = parts[2] ?? '0';
  return patch.padStart(2, '0');
}

const latest = latestRelease;
---

<Base
  title="Changelog · Heart"
  description="Release log for Heart. On-device wellness intelligence for the Coospo HW9, worn on the chest or arm, and any standard BLE chest strap."
>
  <Nav />

  <main class="min-h-screen pt-24 pb-24 px-6">
    <div class="max-w-3xl mx-auto">

      <div aria-hidden="true" class="absolute top-24 left-1/2 -translate-x-1/2 w-[60%] h-64 bg-accent/[0.06] blur-3xl pointer-events-none"></div>

      <SectionEyebrow num="00" label="RELEASE LOG" align="center" />

      <h1 class="text-4xl md:text-5xl font-black text-primary text-center mb-4 tracking-tight">
        Every Heart release so far
      </h1>
      <p class="text-secondary text-center max-w-xl mx-auto mb-3 leading-relaxed">
        Mostly this is the sleep stager being corrected: it spent months disagreeing with reality about what counts as sleep, and those thresholds got walked back one at a time.
      </p>
      <p class="text-hint text-center text-xs font-mono mb-16">
        Latest release: {latest.tag} · {fmtDate(latest.date)}
      </p>

      <ol class="space-y-14">
        {releases.map((r) => (
          <li>
            <SectionEyebrow
              num={eyebrowNum(r.tag)}
              label={r.upcoming ? `${r.tag.toUpperCase()} · COMING NEXT` : `${r.tag.toUpperCase()} · ${kindLabel[r.kind]}`}
              align="left"
            />
            {r.upcoming ? (
              <p class="text-xs font-mono mb-2 text-amber-300">
                In testing · not downloadable yet
              </p>
            ) : (
              <p class="text-hint text-xs font-mono mb-2">
                {fmtDate(r.date)}
              </p>
            )}
            <h2 class="text-primary font-semibold text-lg mb-2 leading-snug">
              {r.title}
            </h2>
            <p class="text-secondary leading-relaxed text-sm">
              {r.body}
            </p>
          </li>
        ))}
      </ol>

      <div class="mt-20 pt-10 border-t border-border text-center text-xs text-hint space-y-2">
        <p>
          Per-release SHA-256s, build details and APK download counts sit on
          <a href="https://github.com/pointbreaklab-hub/Heart/releases"
             class="text-accent hover:underline"
             rel="noopener">GitHub</a>.
        </p>
      </div>
    </div>
  </main>

  <Footer />
</Base>
