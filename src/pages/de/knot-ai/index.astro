    <div class="relative">
      <div class="section-reveal text-center mb-12">
        <SectionEyebrow num="05" label="AUSFÜHREN" />
        <h2 class="text-3xl md:text-5xl font-black text-primary mb-4">So startest du es</h2>
        <p class="text-secondary max-w-xl mx-auto leading-relaxed">
          Scribe ergibt nur bei einem Diff aus der Staging-Area Sinn. Delta liest jeden Diff, den du ihm gibst.
        </p>
      </div>

      <div class="section-reveal space-y-4">
        {/* Knot Scribe */}
        <div class="rounded-2xl bg-bg border border-border overflow-hidden">
          <div class="flex items-center gap-2 px-5 py-3 border-b border-border bg-surface">
            <div class="w-3 h-3 rounded-full bg-error/70"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
            <div class="w-3 h-3 rounded-full bg-accent/70"></div>
            <span class="ml-2 text-hint text-xs font-mono">KNOT SCRIBE · Commit-Message</span>
          </div>
          <pre class="p-5 text-xs md:text-sm font-mono text-primary/90 overflow-x-auto"><code>ollama run pointbreaklab/knot-scribe "$(git diff --staged)"</code></pre>
        </div>
        {/* Knot Delta */}
        <div class="rounded-2xl bg-bg border border-border overflow-hidden">
          <div class="flex items-center gap-2 px-5 py-3 border-b border-border bg-surface">
            <div class="w-3 h-3 rounded-full bg-error/70"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
