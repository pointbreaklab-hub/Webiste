              ['VO2max',           'Herzfrequenz-Verhältnis-Methode · Uth et al. · Eur. J. Appl. Physiol. 91:111 · 2004'],
              ['Kalorien',         'HF + Alter + Gewicht + Geschlecht · Keytel et al. · J. Sports Sci. 23:289 · 2005'],
              ['Distanz',          'Haversine-Großkreis · Näherung mit kugelförmiger Erde'],
              ['Kardialer Drift',  'HF im ersten vs. im letzten Drittel · Ansatz nach Coyle · 1998'],
              ['Belastung',        'TRIMP, zonengewichtete Last · Banister & Calvert · 1975'],
              ['Schlafphasen',     'Regelbasierter Klassifikator auf 5-Minuten-HF-Abschnitten · 4 Phasen'],
              ['Schlaf-Priors',    'Bayessche Nachkorrektur · Sleep-EDF · Kemp et al. 2000'],
              ['Erholung',         'Zusammengesetzt · HRV-Perzentil gegen deine 30-Tage-Baseline'],
              ['Bereitschaft',     'Lineare exponentielle Glättung nach Holt · Holt · ONR memo 52 · 1957'],
              ['Rhythmus-Hinweis', 'Schwellenwerte auf 4 Merkmalen · pNN50 + CoV(RR) + RMSSD + RR-Spannweite'],
              ['Speicher',         'SharedPreferences + JSONL · App-Sandbox · Backups in Download/Heart'],
              ['Netzwerk',         'OpenStreetMap-Kacheln · Update-Prüfung (pointbreaklab.com, ≤ alle 12 h) · nur wenn eingeschaltet: Google-Drive-Backup, Handy-Sync über WLAN'],
              ['Server',           'Keiner'],
            ].map(([key, val]) => (
              <div class="flex flex-col sm:flex-row sm:gap-4 sm:items-baseline font-mono">
                <span class="text-hint shrink-0 sm:w-32">{key}</span>
                <span class="text-primary/80"><span class="text-accent hidden sm:inline" aria-hidden="true">→ </span>{val}</span>
              </div>
            ))}
          </div>
        </div>
      </details>

      <p class="text-hint text-xs text-center max-w-xl mx-auto leading-relaxed">
        Die Validierung oben prüft nur, ob die <span class="text-secondary">Mathematik</span> richtig umgesetzt ist. Über die Genauigkeit des Gesamtsystems sagt sie nichts: Die Schlafphasen wurden noch nicht unabhängig mit PSG verglichen, die Kalorien nicht mit Kalorimetrie.
      </p>
    </div>
  </section>

