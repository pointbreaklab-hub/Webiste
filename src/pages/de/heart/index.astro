---
// German twin of src/pages/heart/index.astro (LANDING REWRITE 2026-09-28).
// Keep structure in sync with it. Open questions for the owner live in the
// English file's frontmatter, not here.
import Base           from '../../../layouts/Base.astro';
import Nav            from '../../../components/Nav.astro';
import DownloadButton from '../../../components/DownloadButton.astro';
import Footer         from '../../../components/Footer.astro';
import HeartArchitectureDiagram from '../../../components/HeartArchitectureDiagram.astro';
import SectionEyebrow from '../../../components/SectionEyebrow.astro';
import { latestRelease, upcomingRelease } from '../../../data/heartReleases';
import '../../../styles/global.css';
// Version, SHA-256 and size are read from the English page at build time
// (src/en-release.ts), so a release only ever edits the English file.
import { releaseConst } from '../../../en-release';

// Keep this EXACT: GitHub Releases auto-resolves "latest" to the newest asset.
const APK_URL = 'https://github.com/pointbreaklab-hub/Heart/releases/latest/download/heart-android.apk';
const EN = 'heart/index.astro';
const VERSION = releaseConst(EN, 'VERSION');
const APK_SHA256 = releaseConst(EN, 'APK_SHA256');
const APK_SIZE = releaseConst(EN, 'APK_SIZE');

// Shared keyboard focus ring (the site had none on this page's controls).
const focusRing = 'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg';

// ── Illustrative hypnogram (example night, NOT user data) ─────────────────
// Stage rows: 0 awake · 1 REM · 2 light · 3 deep. Units are 5-minute buckets,
// matching the app's stager resolution.
const stageMeta = [
  { key: 'awake', label: 'Wach',   color: '#f59e0b' },
  { key: 'rem',   label: 'REM',    color: '#a78bfa' },
  { key: 'light', label: 'Leicht', color: '#60a5fa' },
  { key: 'deep',  label: 'Tief',   color: '#00d4aa' },
];
const night: [number, number][] = [
  [2,3],[3,6],[2,4],[1,2],[2,5],[3,5],[2,3],[0,1],[2,4],[1,4],
  [2,6],[3,3],[2,4],[1,5],[2,5],[0,1],[2,3],[1,6],[2,3],[0,2],
];
const totalUnits = night.reduce((s, [, u]) => s + u, 0);
const hypW = 320, rowH = 26, barH = 12, hypTop = 6;
let cursor = 0;
const hypSegments = night.map(([stage, units]) => {
  const x = (cursor / totalUnits) * hypW;
  const w = (units / totalUnits) * hypW;
  cursor += units;
  const y = hypTop + stage * rowH + (rowH - barH) / 2;
  return { x, w, y, color: stageMeta[stage].color, stage };
});
// Thin connector line tracing stage changes.
const hypPath = hypSegments
  .map((s, i) => `${i === 0 ? 'M' : 'L'}${s.x.toFixed(1)},${(s.y + barH / 2).toFixed(1)} L${(s.x + s.w).toFixed(1)},${(s.y + barH / 2).toFixed(1)}`)
  .join(' ');
const stageMinutes = stageMeta.map((m, idx) => ({
  ...m,
  minutes: night.filter(([s]) => s === idx).reduce((a, [, u]) => a + u * 5, 0),
}));
// German fitness apps write durations as "1:25 h"; "1h 25m" would read "m" as metres.
const fmtHM = (min: number) => (min < 60 ? `${min} min` : `${Math.floor(min / 60)}:${String(min % 60).padStart(2, '0')} h`);
const asleepMinutes = stageMinutes.filter((s) => s.key !== 'awake').reduce((a, s) => a + s.minutes, 0);

// ── FAQ (rendered + mirrored into JSON-LD so they never drift) ────────────
const faqs: { q: string; a: string; href?: { url: string; text: string } }[] = [
  {
    q: 'Brauche ich den Coospo HW9?',
    a: 'Nein. Ich habe Heart mit dem Coospo HW9 entwickelt, den du an Brust, Oberarm oder Unterarm tragen kannst. Es funktioniert aber jeder Gurt, der den standardisierten Bluetooth Heart Rate Service sendet, zum Beispiel Polar H9 und H10, Garmin HRM-Dual oder Wahoo TICKR. Ein Nutzer hat bestätigt, dass der Polar H9 funktioniert.',
  },
  {
    q: 'Gibt es eine iPhone-Version?',
    a: 'Nein. Heart läuft nur auf Android 7.0 oder neuer.',
  },
  {
    q: 'Verlassen meine Daten das Handy?',
    a: 'Nur das, was du selbst verschickst. Jeder Wert wird auf dem Handy berechnet, und Heart hat kein Konto, keinen Server und keine Telemetrie. Die App lädt Kartenkacheln von OpenStreetMap und fragt höchstens alle 12 Stunden bei pointbreaklab.com nach einer neuen Version (eine kleine Versionsdatei; über dich wird dabei nichts gesendet, und du kannst es abschalten). Google-Drive-Backup und die Synchronisierung von Handy zu Handy über WLAN laufen nur, wenn du sie einschaltest.',
  },
  {
    q: 'Was passiert mit meinen Daten, wenn ich die App deinstalliere oder das Handy wechsle?',
    a: 'Heart schreibt seine Backups nach Download/Heart auf dem Handy, und dieser Ordner bleibt beim Deinstallieren erhalten. Nach einer Neuinstallation wählst du in Heart diesen Ordner oder eine Backup-Datei aus, die du vom Handy kopiert hast, und dein Verlauf ist wieder da. Was neuer ist als das letzte Backup, kommt nicht zurück. Lass die automatischen Backups deshalb eingeschaltet. Zum Aktualisieren installierst du die neue APK über die alte. Deine Daten bleiben dabei erhalten.',
  },
  {
    q: 'Brauche ich ein Konto?',
    a: 'Nein. Du bestätigst den Wellness-Hinweis, koppelst deinen Gurt, und die Aufzeichnung beginnt.',
  },
  {
    q: 'Ist Heart ein Medizinprodukt?',
    a: 'Nein. Heart zeigt Wellness-Schätzungen auf Basis eines Herzfrequenzgurts für Endverbraucher. Sie sind keine medizinische Beratung und keine Diagnose. Vor allem Hinweise auf einen unregelmäßigen Rhythmus bedeuten nur, dass etwas ungewöhnlich aussah. Sprich mit qualifiziertem medizinischem Fachpersonal über alles, was dir Sorgen macht.',
  },
  {
    q: 'Warum warnt mich Android bei der Installation?',
    a: 'Heart wird aus einer APK-Datei installiert und nicht aus einem App-Store. Deshalb bittet Android dich beim ersten Mal, die Quelle zu bestätigen. Die Installationsschritte weiter oben behandeln die Meldungen, auf die Leute bisher gestoßen sind, auch Samsung Auto Blocker und Play Protect.',
    href: { url: '#install', text: 'Zu den Installationsschritten' },
  },
];

const heartJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Heart',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Android 7.0+',
  softwareVersion: VERSION,
  description: 'HRV, Schlafphasen, Erholung und Belastung aus einem Bluetooth-Herzfrequenzgurt, berechnet auf dem Handy. Kein Konto und kein Server.',
  downloadUrl: APK_URL,
  publisher: { '@type': 'Organization', name: 'PointBreakLab' },
};
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Base
  title="Heart · HRV, Schlaf und Erholung mit einem Bluetooth-Herzfrequenzgurt"
  description="Android-App, die die R–R-Intervalle von einem Bluetooth-Herzfrequenzgurt liest und daraus auf dem Handy HRV, Schlafphasen, Erholung und Belastung berechnet. Entwickelt mit dem Coospo HW9 (Brust, Oberarm oder Unterarm). Andere Gurte, die den standardisierten Heart Rate Service senden, funktionieren auch. Kein Konto und kein Server."
>
  <Nav />
  <script type="application/ld+json" set:html={JSON.stringify(heartJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <main>
  <section class="relative pt-28 md:pt-36 pb-20 px-6 overflow-hidden">
    <div aria-hidden="true" class="absolute top-0 left-1/2 -translate-x-1/2 w-[80%] h-[28rem] bg-accent/[0.08] blur-3xl pointer-events-none"></div>
    <div aria-hidden="true" class="absolute top-1/3 right-0 w-72 h-72 bg-blue-500/[0.05] blur-3xl pointer-events-none"></div>

    <div class="relative max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-14 lg:gap-10 items-center">
      <div class="text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-accent/30 bg-accent/5 text-accent text-xs font-mono tracking-wider mb-8">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          HEART · FÜR ANDROID
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight leading-[1.05] mb-6">
          <span class="text-primary">HRV, Schlaf und Erholung,</span><br/>
          <span class="text-gradient">auf dem Handy berechnet.</span>
        </h1>

        <p class="text-lg md:text-xl text-secondary font-light max-w-xl mx-auto lg:mx-0 leading-relaxed mb-4">
          Heart liest die R–R-Intervalle von einem Bluetooth-Herzfrequenzgurt und berechnet daraus <span class="text-primary">HRV, Schlafphasen, Erholung und Belastung</span>. Es gibt kein Konto und keinen Heart-Server, an den deine Daten gehen könnten.
        </p>
        <p class="text-sm text-hint font-mono mb-10">
          Coospo HW9 · Polar · Garmin · Wahoo · jeder 0x180D-Gurt
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href={APK_URL}
            class={`inline-flex items-center gap-2.5 px-8 py-3.5 rounded-xl bg-accent text-bg font-bold text-sm hover:bg-white transition-all hover:scale-105 hover:shadow-[0_0_32px_rgba(0,212,170,0.4)] ${focusRing}`}
          >
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M3 13h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            APK herunterladen
          </a>
          <a
            href="#install"
            class={`px-8 py-3.5 rounded-xl border border-border text-secondary text-sm hover:border-accent hover:text-primary transition-all ${focusRing}`}
          >
            So installierst du es
          </a>
        </div>
        <p class="text-xs text-hint font-mono mt-5">
          v{VERSION} · Android 7.0+ · {APK_SIZE} · kostenlos · <a href="#whats-new" class={`text-accent hover:underline rounded ${focusRing}`}>was ist neu</a>
        </p>
      </div>

      <div class="relative flex justify-center">
        <div aria-hidden="true" class="absolute inset-x-10 top-10 bottom-10 bg-accent/[0.10] blur-3xl rounded-full pointer-events-none"></div>
        <div class="relative w-[240px] sm:w-[260px]">
          <div class="rounded-[38px] border-2 border-[#23232a] bg-[#0e0e11] p-2.5"
               style="box-shadow:0 32px 80px rgba(0,0,0,0.8),0 0 0 1px rgba(255,255,255,0.025)">
            <div class="rounded-[30px] overflow-hidden" style="aspect-ratio:1080/2340">
              <img
                src="/screenshots/heart/flutter_01.png"
                width="1080" height="2340"
                alt="Der Home-Bildschirm von Heart: ein verbundener HW9-Gurt mit 53% Akku, ein Live-Puls von 104 bpm in Zone 2 mit laufender Kurve und die aktiven Kalorien von heute"
                class="w-full h-full object-cover"
                fetchpriority="high"
              />
            </div>
          </div>
          <div aria-hidden="true" class="hidden xl:flex absolute -left-44 top-24 items-center gap-2 px-3 py-2 rounded-xl bg-surface border border-border text-xs text-secondary font-mono shadow-lg">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span> lokal berechnet
          </div>
          <div aria-hidden="true" class="hidden xl:flex absolute -right-36 bottom-32 items-center gap-2 px-3 py-2 rounded-xl bg-surface border border-border text-xs text-secondary font-mono shadow-lg">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span> kein Konto
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="compatibility" class="relative py-24 px-6 max-w-6xl mx-auto scroll-mt-20">
    <div aria-hidden="true" class="absolute top-0 left-1/4 w-[40%] h-72 bg-accent/[0.06] blur-3xl pointer-events-none"></div>

    <div class="relative section-reveal text-center mb-14">
      <SectionEyebrow num="01" label="DER GURT" />
      <h2 class="text-3xl md:text-5xl font-black text-primary mb-4">Welche Gurte funktionieren</h2>
      <p class="text-secondary max-w-2xl mx-auto leading-relaxed">
        Heart liest den standardisierten Bluetooth Heart Rate Service (0x180D). Deshalb funktionieren auch Gurte anderer Marken.
      </p>
    </div>

    <div class="relative grid grid-cols-1 lg:grid-cols-2 gap-5">
      <div class="section-reveal p-6 md:p-8 rounded-2xl bg-surface border border-accent/30 flex flex-col sm:flex-row gap-6 items-center">
        <figure class="shrink-0" aria-labelledby="wear-caption">
          <svg viewBox="0 0 160 200" width="150" height="188" role="img" aria-labelledby="wear-title">
            <title id="wear-title">Figur mit drei Trageorten für den Coospo HW9: Brust, Oberarm und Unterarm</title>
            <g fill="none" stroke="#3a3a44" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="80" cy="26" r="15" />
              <path d="M58 52 Q80 44 102 52 L106 118 Q80 124 54 118 Z" />
              <path d="M58 54 L40 96 L34 140" />
              <path d="M102 54 L120 96 L126 140" />
              <path d="M62 120 L60 190 M98 120 L100 190" />
            </g>
            <path d="M57 72 Q80 78 103 72" stroke="#00d4aa" stroke-width="5" stroke-linecap="round" fill="none" />
            <path d="M44 80 L54 85" stroke="#00d4aa" stroke-width="5" stroke-linecap="round" />
            <path d="M121 110 L131 112" stroke="#00d4aa" stroke-width="5" stroke-linecap="round" />
            <g font-family="JetBrains Mono, monospace" font-size="8" fill="#888888">
              <text x="80" y="92" text-anchor="middle">BRUST</text>
              <text x="4" y="70">OBER-</text><text x="4" y="79">ARM</text>
              <text x="128" y="128">UNTER-</text><text x="128" y="137">ARM</text>
            </g>
          </svg>
          <figcaption id="wear-caption" class="sr-only">Den HW9 kannst du an Brust, Oberarm oder Unterarm tragen.</figcaption>
        </figure>
        <div class="text-center sm:text-left">
          <div class="inline-block px-2 py-0.5 rounded bg-accent/10 text-accent text-xs font-mono mb-3">ENTWICKELT MIT</div>
          <h3 class="text-xl font-bold text-primary mb-2">Coospo HW9</h3>
          <p class="text-secondary text-sm leading-relaxed">
            Getragen an <span class="text-primary">Brust, Oberarm oder Unterarm</span>. Das ist der Gurt, den ich selbst trage, und Heart wurde mit ihm entwickelt und getestet. Er liefert den Live-Puls, die Schlag-zu-Schlag-Intervalle für die HRV und den Akkustand.
          </p>
        </div>
      </div>

      <div class="section-reveal p-6 md:p-8 rounded-2xl bg-surface border border-border hover:border-accent/30 transition-colors">
        <div class="inline-block px-2 py-0.5 rounded bg-accent/10 text-accent text-xs font-mono mb-3">FUNKTIONIERT AUCH MIT</div>
        <h3 class="text-xl font-bold text-primary mb-2">Jeder Standard-Bluetooth-Gurt</h3>
        <p class="text-secondary text-sm leading-relaxed mb-5">
          Wenn er den Bluetooth Heart Rate Service (<span class="font-mono text-primary/80">0x180D</span>) sendet, kann Heart ihn lesen.
        </p>
        <ul class="flex flex-wrap gap-2 mb-5" aria-label="Beispiele für kompatible Gurte">
          {['Polar H9', 'Polar H10', 'Garmin HRM-Dual', 'Wahoo TICKR'].map((s) => (
            <li class="px-3 py-1.5 rounded-lg bg-bg border border-border text-sm text-primary/90">{s}</li>
          ))}
          <li class="px-3 py-1.5 rounded-lg border border-dashed border-border text-sm text-hint">und ähnliche</li>
        </ul>
        <p class="text-xs text-hint leading-relaxed">
          <span class="text-accent" aria-hidden="true">✓</span> Ein Heart-Nutzer hat bestätigt, dass der Polar H9 funktioniert. Für die HRV braucht Heart Schlag-zu-Schlag-Intervalle (RR). Ein Gurt, der sie nicht sendet, liefert trotzdem den Live-Puls. Optische Sensoren am Handgelenk melden sie ungleichmäßig, deshalb ist ihre HRV gröber.
        </p>
      </div>
    </div>
  </section>

  <section id="features" class="relative py-24 px-6 max-w-6xl mx-auto scroll-mt-20">
    <div aria-hidden="true" class="absolute top-10 right-0 w-[45%] h-72 bg-blue-500/[0.04] blur-3xl pointer-events-none"></div>

    <div class="relative section-reveal text-center mb-16">
      <SectionEyebrow num="02" label="WAS ES MACHT" />
      <h2 class="text-3xl md:text-5xl font-black text-primary mb-4">Was Heart berechnet, während du den Gurt trägst</h2>
      <p class="text-secondary max-w-2xl mx-auto leading-relaxed">
        Schlaf und Erholung ergeben sich aus dem nächtlichen Puls. Gym-Sessions starten an deinem gespeicherten Standort. Spaziergänge, Läufe und Radtouren startest du selbst.
      </p>
    </div>

    <div class="relative space-y-20 md:space-y-24">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14 items-center">
        <div class="section-reveal">
          <p class="text-accent text-xs font-mono tracking-widest mb-3">BRIEF-TAB</p>
          <h3 class="text-2xl md:text-3xl font-black text-primary mb-4">Der Brief-Tab</h3>
          <p class="text-secondary leading-relaxed mb-5">
            Der Brief-Tab zeigt einen Bereitschaftswert, einen Vorschlag für den Schwerpunkt des Tages, deinen Stress, die heutige Belastung und wie weit du unterwegs warst. Darunter schätzt eine Holt-Prognose die HRV der nächsten Nacht aus den letzten ein bis zwei Wochen. Sie braucht fünf Nächte, bevor sie startet, und sie schwankt.
          </p>
          <ul class="space-y-2 text-sm text-secondary">
            <li class="flex gap-2"><span class="text-accent" aria-hidden="true">→</span>Bereitschaft und Erholung werden an deinen letzten 30 Nächten gemessen</li>
            <li class="flex gap-2"><span class="text-accent" aria-hidden="true">→</span>Der Schwerpunkt ist einer von vier Werten: push, maintain, easy oder rest. Die Belastung ist zonengewichtete Anstrengung auf einer Skala von 0 bis 21</li>
            <li class="flex gap-2"><span class="text-accent" aria-hidden="true">→</span>Tippe auf die Distanzzeile, dann siehst du die Route des Tages auf einer Karte</li>
            <li class="flex gap-2"><span class="text-accent" aria-hidden="true">→</span>Teile die Tagesübersicht aus dem Brief-Tab als Story-Bild, samt den Gründen für den Wert</li>
          </ul>
        </div>

        <figure class="section-reveal">
          <div role="img" aria-label="Illustration der Karte im Brief-Tab von Heart: Bereitschaft 71%, Schwerpunkt Maintain, Stress ausgeglichen, Belastung 6,2 von 21, heute 4,2 km unterwegs, Prognose für morgen stabil." class="max-w-sm mx-auto rounded-3xl bg-[#101a19] border border-[#1f2e2c] p-5 shadow-[0_24px_60px_-20px_rgba(0,0,0,0.9)]">
            <div class="flex items-center gap-2 mb-4" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#00d4aa"><path d="M12 2l1.8 5.2L19 9l-5.2 1.8L12 16l-1.8-5.2L5 9l5.2-1.8zM19 14l.9 2.1L22 17l-2.1.9L19 20l-.9-2.1L16 17l2.1-.9z"/></svg>
              <span class="text-primary text-sm font-semibold">Brief</span>
              <span class="ml-auto text-xs text-secondary">Bereitschaft 71%</span>
            </div>
            <div class="space-y-2.5 text-sm" aria-hidden="true">
              <div class="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-accent/10 border border-accent/25">
                <span class="w-2 h-2 rounded-full bg-accent"></span>
                <span class="text-primary font-semibold">Maintain · gleichmäßig</span>
              </div>
              <div class="flex items-center gap-3 px-3 py-2">
                <span class="w-2 h-2 rounded-full bg-sky-400"></span>
                <span class="text-secondary">Stress · ausgeglichen (42)</span>
              </div>
              <div class="flex items-center gap-3 px-3 py-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                <span class="text-secondary">Belastung · 6,2 / 21 (leichter Tag)</span>
              </div>
              <div class="flex items-center gap-3 px-3 py-2">
                <span class="w-2 h-2 rounded-full bg-violet-400"></span>
                <span class="text-secondary">Heute 4,2 km unterwegs</span>
              </div>
            </div>
            <div class="mt-4 pt-4 border-t border-[#1f2e2c] flex items-center justify-between text-xs" aria-hidden="true">
              <span class="text-secondary">Prognose für morgen</span>
              <span class="px-2 py-0.5 rounded-full bg-sky-400/10 text-sky-300 border border-sky-400/25">Stabil</span>
            </div>
          </div>
          <figcaption class="text-center text-[11px] text-hint font-mono mt-3">Illustration · Beispielwerte</figcaption>
        </figure>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14 items-center">
        <div class="section-reveal md:order-2">
          <p class="text-accent text-xs font-mono tracking-widest mb-3">SCHLAF &amp; ERHOLUNG</p>
          <h3 class="text-2xl md:text-3xl font-black text-primary mb-4">Schlaf aus dem nächtlichen Puls</h3>
          <p class="text-secondary leading-relaxed mb-5">
            Trag den Gurt im Bett. Heart sucht im nächtlichen Puls nach Schlaf, in Abschnitten von 5 Minuten, und teilt die Nacht in wach, leicht, tief und REM auf. Die Phasenerkennung besteht aus Schwellenwerten und ist kein trainiertes Modell. Mit einem Schlaflabor abgeglichen wurde sie nicht. Wenn eine Nacht offensichtlich falsch erkannt ist, kannst du sie korrigieren. Nächtliche HRV (RMSSD) und Ruhepuls fließen in den Erholungswert ein, der die letzte Nacht mit deinen 30 Nächten davor vergleicht.
          </p>
        </div>

        <figure class="section-reveal md:order-1">
          <div role="img" aria-label={`Illustration eines Schlafprofils für eine Beispielnacht: ${fmtHM(asleepMinutes)} Schlaf, aufgeteilt in die Phasen wach, REM, leicht und tief.`} class="max-w-md mx-auto rounded-3xl bg-surface border border-border p-5 md:p-6">
            <div class="flex items-baseline justify-between mb-4" aria-hidden="true">
              <div>
                <p class="text-xs text-hint font-mono tracking-widest">LETZTE NACHT</p>
                <p class="text-2xl font-black text-primary">{fmtHM(asleepMinutes)}</p>
              </div>
              <p class="text-xs text-secondary font-mono">23:40 → 06:55</p>
            </div>
            <svg viewBox={`0 0 ${hypW + 44} ${hypTop * 2 + rowH * 4}`} class="w-full h-auto" aria-hidden="true">
              {stageMeta.map((m, i) => (
                <text x={hypW + 8} y={hypTop + i * rowH + rowH / 2 + 3} font-size="9" fill="#737373" font-family="JetBrains Mono, monospace">{m.label}</text>
              ))}
              {stageMeta.map((_, i) => (
