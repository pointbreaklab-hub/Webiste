---
import Base   from '../../layouts/Base.astro';
import Nav    from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SectionEyebrow from '../../components/SectionEyebrow.astro';
import '../../styles/global.css';

// User-facing release log for Knot. Dev-facing detail lives on
// GitHub Releases (https://github.com/pointbreaklab-hub/knot/releases).
//
// Style notes:
//  - Newest first.
//  - Each entry is one short paragraph in user-facing prose.
//  - Skip releases that shipped briefly and got pulled, log only what
//    users actually saw and could run.

interface Release {
  tag: string;
  date: string;        // YYYY-MM-DD
  title: string;
  body: string;
  kind: 'feature' | 'fix' | 'polish' | 'note';
}

// OWNER DECISION: first person "I" proposed in the v1.0.0 body. "I installed the
// .deb on the Linux box and read dpkg's log to check it had landed" is the honest
// version; shipped here agentless because the site has no "I" yet.
//
// OPEN QUESTIONS. They live here and not in the copy: Astro emits HTML comments
// into the page and a bracketed marker inside a body string renders as visible
// text, so an editorial note in the template ships to the reader.
//  - v1.0.2: the internal record has the soak harness flagging five refusals,
//    all five real. The figure is withheld here until the run and the date it
//    came from can be stated next to it.
//  - v1.0.2 / v1.0.1 / v1.0.0: "the Mac" and "the Linux box" are the two
//    machines in the internal record. Confirm they can be named in public copy.
//  - v0.1.0: which machine the self-contained binaries were launched on.
//  - v1.0.0: whether Windows is missing for want of time or want of a
//    toolchain, so the sentence can say which.
const releases: Release[] = [
  {
    tag: 'v1.0.2',
    date: '2026-08-26',
    kind: 'fix',
    title: 'Sending files over Tor now works',
    body: 'Fixes the known issue from v1.0.1: sending a file attachment over Tor never worked (every transfer failed immediately). Transfers now retry after a network hiccup instead of giving up. Cloning a project over Tor could also leave an empty folder while reporting success when your git default branch name differed from the project\'s; the clone now checks out the right branch or refuses loudly. Both went through the soak harness, Mac to Linux box and back over Tor, with the file checksummed at each end. Two machines both editing the same project over slow links will still diverge, and Knot stops instead of merging behind your back. Full merge support is the next major feature. Upgrade from v1.0.0 or v1.0.1.',
  },
  {
    tag: 'v1.0.1',
    date: '2026-08-26',
    kind: 'fix',
    title: 'The receiver got the message and not the file',
    body: 'The sender saw "delivered" and the receiver got a message with no file. A file attachment sent over an established peer session was being dropped silently: two of the three session paths were missing the chunk-handling the third already had. The fix closes both, and a 41 MB transfer from the Mac to the Linux box now arrives byte-for-byte. If you are on v1.0.0, upgrade: reinstall the app (macOS) or `sudo apt install ./knot-vcs-amd64.deb` (Linux). Nothing else about your setup changes. Your projects and your pairings are where you left them.',
  },
  {
    tag: 'v1.0.0',
    date: '2026-08-26',
    kind: 'feature',
    title: 'V1: a proper .deb, signed commits, and a first run that no longer skips the identity step',
    body: 'Knot\'s first complete release. Before it went out, the .dmg went on the Mac and the .deb on the Linux box, with dpkg\'s log read afterwards to check it had really landed. Linux moves from a tarball to a proper .deb: one `sudo apt install` command handles dependencies, systemd service integration, and clean in-place upgrades. Every commit is now signed by your device identity and verifiable with plain `git log --show-signature` on any machine, no Knot tooling needed to check the receipt. The welcome screen was the embarrassing part. A fast double-click could skip the identity step entirely or hit a button that had not appeared yet, and the security prompts (trust this network, accept this device) would surface behind the welcome instead of waiting their turn. Both fixed. The app icon is now a proper macOS icon. New: a step-by-step installation guide covering macOS, Linux, download verification, and your first synced save. macOS is not yet notarized (one-time Gatekeeper step), merges of diverged histories are manual via `git`, and there is no Windows build.',
  },
  {
    tag: 'v0.1.0',
    date: '2026-07-12',
    kind: 'feature',
    title: 'Public free download, macOS + Linux, self-contained',
    body: 'The first public build of Knot that runs anywhere, with nothing to install first. Drop any folder into Knot and every save becomes a real git commit that syncs to your paired machines, peer-to-peer over Tor and your local network. The macOS app (.dmg) and the Linux tarball (x86_64, glibc 2.31+) now carry their own openssl and their own runtime, so the binaries launch on a machine that has never had Homebrew or a Rust toolchain on it. macOS is ad-hoc-signed (not yet Apple-notarized), so the first launch needs a one-time Gatekeeper wave-through; the steps are on the download page. Under the hood it is real git, so you can drop to plain git commands any time. A first-run wizard and a notarized installer were both still ahead.',
  },
];

const fmtDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  const dt = new Date(Date.UTC(y, m - 1, d));
  return dt.toLocaleDateString('en-US', {
    month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
  });
};

const kindLabel: Record<Release['kind'], string> = {
  feature: 'FEATURE',
  fix:     'FIX',
  polish:  'POLISH',
  note:    'NOTE',
};

function eyebrowNum(tag: string): string {
  const parts = tag.replace(/^v/, '').split('.');
  const patch = parts[2] ?? '0';
  return patch.padStart(2, '0');
}

const latest = releases[0];
---

<Base
  title="Changelog · Knot"
  description="Release log for Knot, the peer-to-peer version control app for macOS and Linux."
>
  <Nav />

  <main class="min-h-screen pt-24 pb-24 px-6">
    <div class="max-w-3xl mx-auto">

      <div aria-hidden="true" class="absolute top-24 left-1/2 -translate-x-1/2 w-[60%] h-64 bg-accent/[0.06] blur-3xl pointer-events-none"></div>

      <SectionEyebrow num="00" label="SHIPPED" align="center" />

      <h1 class="text-4xl md:text-5xl font-black text-primary text-center mb-4 tracking-tight">
        Knot releases
      </h1>
      <p class="text-secondary text-center max-w-xl mx-auto mb-3 leading-relaxed">
        v1.0.0 through v1.0.2 all carry the same date, August 26, 2026. V1 shipped that day, and two fixes followed it before the day was over.
      </p>
      <p class="text-hint text-center text-xs font-mono mb-16">
        Latest: {latest.tag} · {fmtDate(latest.date)}
      </p>

      <ol class="space-y-14">
        {releases.map((r) => (
          <li>
            <SectionEyebrow
              num={eyebrowNum(r.tag)}
              label={`${r.tag.toUpperCase()} · ${kindLabel[r.kind]}`}
              align="left"
            />
            <p class="text-hint text-xs font-mono mb-2">
              {fmtDate(r.date)}
            </p>
            <h2 class="text-primary font-semibold text-lg mb-2 leading-snug">
              {r.title}
            </h2>
            <p class="text-secondary leading-relaxed text-sm">
              {r.body}
            </p>
          </li>
        ))}
      </ol>

      <div class="mt-20 pt-10 border-t border-border text-center text-xs text-hint space-y-2">
        <p>
          Each download has a SHA-256 and build details on
          <a href="https://github.com/pointbreaklab-hub/knot/releases"
             class="text-accent hover:underline"
             rel="noopener">GitHub</a>.
        </p>
      </div>
    </div>
  </main>

  <Footer />
</Base>
