---
import { localeFromPath, href, t } from '../i18n';
const year = new Date().getFullYear();
const locale = localeFromPath(Astro.url.pathname);
const l = (p: string) => href(p, locale);
---
<footer class="border-t border-border bg-surface mt-32">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 mb-12">

      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-7 h-7 rounded-md bg-accent flex items-center justify-center">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M7 1L13 4V10L7 13L1 10V4L7 1Z" stroke="black" stroke-width="1.5" stroke-linejoin="round"/>
              <path d="M7 4L10 5.5V8.5L7 10L4 8.5V5.5L7 4Z" fill="black"/>
            </svg>
          </div>
          <span class="font-bold text-sm text-primary">PointBreak<span class="text-accent">Lab</span></span>
        </div>
        <p class="text-secondary text-sm leading-relaxed">
          {t(locale, 'footerTagline')}
        </p>
        {/* OWNER DECISION: first person "I" proposed here */}
      </div>

      <!-- Apps -->
      <div>
        <h4 class="text-xs font-semibold text-hint uppercase tracking-widest mb-4">{t(locale, 'apps')}</h4>
        <ul class="space-y-3 text-sm text-secondary">
          <li><a href={l('/whispr/')} class="hover:text-primary transition-colors">Whispr</a></li>
          <li><a href={l('/heart/')}  class="hover:text-primary transition-colors">Heart</a></li>
          <li><a href={l('/knot/')} class="hover:text-primary transition-colors">Knot</a></li>
          <li><a href={l('/knot-ai/')} class="hover:text-primary transition-colors">Knot AI <span class="text-xs text-hint">{t(locale, 'openModel')}</span></a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="text-xs font-semibold text-hint uppercase tracking-widest mb-4">{t(locale, 'resources')}</h4>
        <ul class="space-y-3 text-sm text-secondary">
          <li><a href={l('/whispr/#architecture')} class="hover:text-primary transition-colors">{t(locale, 'security')}</a></li>
          <li><a href="/whispr/changelog/"      class="hover:text-primary transition-colors">{t(locale, 'whisprChangelog')}</a></li>
          <li><a href="/heart/changelog/"       class="hover:text-primary transition-colors">{t(locale, 'heartChangelog')}</a></li>
          <li><a href="/knot/changelog/"        class="hover:text-primary transition-colors">{t(locale, 'knotChangelog')}</a></li>
          <li><a href={l('/knot/docs/')} class="hover:text-primary transition-colors">{t(locale, 'knotInstall')}</a></li>
          <li><a href={l('/whispr/#download')} class="hover:text-primary transition-colors">{t(locale, 'download')}</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="text-xs font-semibold text-hint uppercase tracking-widest mb-4">{t(locale, 'legal')}</h4>
        <ul class="space-y-3 text-sm text-secondary">
          <li><a href={l('/privacy/')} class="hover:text-primary transition-colors">{t(locale, 'whisprPrivacy')}</a></li>
          <li><a href={l('/heart/privacy/')} class="hover:text-primary transition-colors">{t(locale, 'heartPrivacy')}</a></li>
          <li><a href={l('/knot/privacy/')} class="hover:text-primary transition-colors">{t(locale, 'knotPrivacy')}</a></li>
          <li><a href={l('/#about')} class="hover:text-primary transition-colors">{t(locale, 'contact')}</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-border pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-hint">
      <span>© {year} PointBreakLab. {t(locale, 'rights')}</span>
      <span class="font-mono">🇩🇪 {t(locale, 'madeIn')}</span>
      <span class="font-mono">{t(locale, 'staticNote')}</span>
    </div>
  </div>
</footer>
